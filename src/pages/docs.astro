    background: var(--bg-input);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 13px;
    outline: none;
    transition: border-color var(--transition);
  }

  #try-it-input:focus {
    border-color: var(--accent);
  }

  .try-it-send {
    flex-shrink: 0;
    background: var(--accent-subtle);
    border-color: var(--accent);
    color: var(--accent);
  }

  .try-it-send:hover {
    background: var(--accent);
    color: white;
  }

  .try-it-result {
    margin-top: 16px;
  }

  .try-it-result.hidden {
    display: none;
  }

  .try-it-result-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 8px;
  }

  .try-it-status {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: var(--radius-sm);
  }

  .try-it-status.success {
    color: var(--green);
    background: var(--green-bg);
  }

  .try-it-status.error {
    color: var(--red);
    background: var(--red-bg);
  }

  .try-it-time {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-dim);
  }

  /* ── Info Box ── */
  .info-box {
    display: flex;
    gap: 12px;
    padding: 16px 18px;
    background: var(--accent-subtle);
    border: 1px solid rgba(129, 140, 248, 0.15);
    border-radius: var(--radius-md);
    margin-top: 8px;
  }

  .info-box-icon {
    color: var(--accent);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .info-box strong {
    color: var(--text-primary);
    font-size: 13px;
  }

  .info-box p {
    color: var(--text-secondary);
    font-size: 12px;
    line-height: 1.6;
    margin-top: 4px;
  }

  .info-box code {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--accent);
    background: var(--bg-overlay);
    padding: 1px 4px;
    border-radius: 3px;
  }

  .rate-limit-note {
    margin-top: 16px;
    font-size: 12px;
    color: var(--text-muted);
  }

  .rate-limit-note code {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--amber);
