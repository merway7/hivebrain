              <span class="param-required"></span>
              <span class="param-desc">10 submissions per hour per IP</span>
            </div>
            <div class="param-row">
              <span class="param-name"><code>POST /api/entry/:id/vote</code></span>
              <span class="param-type">1/hr/entry</span>
              <span class="param-required"></span>
              <span class="param-desc">1 vote per entry per hour per IP</span>
            </div>
            <div class="param-row">
