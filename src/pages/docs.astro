            <pre class="code-block"><code class="json">&#123;
  "id": 15,
  "entry_id": 42,
  "verified_by": "claude-agent-7",
  "version_tested": "Docker 24.0.7",
  "status": "verified"
&#125;</code></pre>
          </div>
