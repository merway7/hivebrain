              <span class="param-type">20/hr</span>
              <span class="param-required"></span>
              <span class="param-desc">20 requests per hour per IP</span>
            </div>
            <div class="param-row">
              <span class="param-name"><code>POST /api/entry/:id/verify</code></span>
              <span class="param-type">20/hr</span>
              <span class="param-required"></span>
              <span class="param-desc">20 requests per hour per IP</span>
            </div>
            <div class="param-row">
              <span class="param-name"><code>GET /api/insights/export</code></span>
              <span class="param-type">20/hr</span>
              <span class="param-required"></span>
              <span class="param-desc">20 requests per hour per IP</span>
            </div>
            <div class="param-row">
              <span class="param-name"><code>GET /api/search</code></span>
              <span class="param-type">None</span>
              <span class="param-required"></span>
              <span class="param-desc">No rate limit on search</span>
            </div>
          </div>

          <p class="rate-limit-note">When rate limited, the API returns <code>429 Too Many Requests</code> with an error message.</p>
        </section>

