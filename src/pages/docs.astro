  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .docs-layout {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .docs-sidebar {
      position: static;
      max-height: none;
      border-bottom: 1px solid var(--border);
      padding-bottom: 16px;
      margin-bottom: 8px;
    }

    .sidebar-nav {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 4px;
    }

    .sidebar-group {
      margin-top: 0;
      display: contents;
    }

    .sidebar-group-title {
      display: none;
    }

    .param-row {
      grid-template-columns: 120px 70px 80px 1fr;
    }
  }

  @media (max-width: 600px) {
    .docs-page {
      padding: 16px;
    }

    .param-row {
      grid-template-columns: 1fr;
      gap: 4px;
    }

    .param-row.header-row {
      display: none;
    }

    .param-name::before { content: none; }
    .param-type::before { content: "Type: "; color: var(--text-dim); }
    .param-required::before { content: "Required: "; color: var(--text-dim); }

    .try-it-input-row {
      flex-wrap: wrap;
    }

    .try-it-path {
      display: none;
    }

    .endpoint-header {
      flex-wrap: wrap;
      gap: 8px;
    }
  }
</style>

<script>
  // ── Try It ──
  const tryInput = document.getElementById('try-it-input') as HTMLInputElement;
  const tryBtn = document.getElementById('try-it-btn');
  const tryResult = document.getElementById('try-it-result');
  const tryOutput = document.getElementById('try-it-output');
  const tryStatus = document.getElementById('try-it-status');
  const tryTime = document.getElementById('try-it-time');

  async function runSearch() {
    const query = tryInput?.value.trim();
    if (!query) return;

    tryBtn!.textContent = '...';
    tryResult!.classList.remove('hidden');
    tryOutput!.textContent = 'Loading...';
    tryStatus!.textContent = '';
    tryStatus!.className = 'try-it-status';
    tryTime!.textContent = '';

    const start = performance.now();
    try {
      const res = await fetch(`/api/search?q=${encodeURIComponent(query)}&limit=5`);
      const elapsed = Math.round(performance.now() - start);
      const data = await res.json();

      tryStatus!.textContent = `${res.status} ${res.statusText}`;
      tryStatus!.classList.add(res.ok ? 'success' : 'error');
      tryTime!.textContent = `${elapsed}ms`;
      tryOutput!.textContent = JSON.stringify(data, null, 2);
    } catch (err: any) {
      const elapsed = Math.round(performance.now() - start);
      tryStatus!.textContent = 'Error';
      tryStatus!.classList.add('error');
      tryTime!.textContent = `${elapsed}ms`;
      tryOutput!.textContent = err.message || 'Network error';
    }
    tryBtn!.textContent = 'Send';
  }

  tryBtn?.addEventListener('click', runSearch);
  tryInput?.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Enter') runSearch();
  });

  // ── Copy Buttons ──
  document.querySelectorAll('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetId = (btn as HTMLElement).dataset.copy;
      const target = targetId ? document.getElementById(targetId) : null;
      const text = target?.textContent || '';

      navigator.clipboard.writeText(text).then(() => {
        const original = btn.textContent;
        btn.textContent = 'Copied!';
        btn.classList.add('copied');
        setTimeout(() => {
          btn.textContent = original;
          btn.classList.remove('copied');
        }, 1500);
      });
    });
  });

  // ── Active Sidebar Link on Scroll ──
  const sections = document.querySelectorAll('.docs-section[id]');
  const sidebarLinks = document.querySelectorAll('.sidebar-link[data-section]');

  const observer = new IntersectionObserver((entries) => {
    for (const entry of entries) {
      if (entry.isIntersecting) {
        const id = entry.target.id;
        sidebarLinks.forEach((link) => {
          link.classList.toggle('active', (link as HTMLElement).dataset.section === id);
        });
      }
    }
  }, { rootMargin: '-20% 0px -70% 0px' });

  sections.forEach((section) => observer.observe(section));
</script>
