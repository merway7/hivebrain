---
import Layout from '../../layouts/Layout.astro';
import { getWiki, listPages, listSources, getPage, getSource, getPageRevisions, getLog, getWikiStats } from '../../lib/wikis';

const slug = Astro.params.slug;
if (!slug || !slug.includes('/')) {
  return Astro.redirect('/wikis');
}

const parts = slug.split('/');
const fullSlug = `${parts[0]}/${parts[1]}`;

const wiki = await getWiki(fullSlug);
if (!wiki) {
  return Astro.redirect('/wikis');
}

const pages = await listPages(wiki.id);
const sources = await listSources(wiki.id);
const stats = await getWikiStats(wiki.id);
const recentLog = await getLog(wiki.id, 20);

// Build category groups from page paths
interface CategoryGroup {
  name: string;
  pages: typeof pages;
  color: string;
  icon: string;
  description: string;
}

const CATEGORY_STYLES: Record<string, { color: string; icon: string; description: string }> = {
  identity:   { color: '#818cf8', icon: 'fingerprint', description: 'Who you are, documents, legal status' },
  finances:   { color: '#34d399', icon: 'wallet',      description: 'Money, accounts, budgets' },
  investing:  { color: '#fbbf24', icon: 'chart',       description: 'Portfolio, strategy, markets' },
  business:   { color: '#60a5fa', icon: 'briefcase',   description: 'Ventures, entities, plans' },
  personal:   { color: '#c084fc', icon: 'heart',       description: 'Health, goals, habits' },
  family:     { color: '#f472b6', icon: 'family',      description: 'Loved ones, plans, memories' },
  people:     { color: '#22d3ee', icon: 'people',      description: 'Contacts, relationships, network' },
  projects:   { color: '#fb923c', icon: 'rocket',      description: 'What you are building' },
  work:       { color: '#f87171', icon: 'building',    description: 'Career, employer, role' },
};

const DEFAULT_STYLE = { color: '#a1a1aa', icon: 'file', description: 'Uncategorized pages' };

const categoryMap = new Map<string, typeof pages>();
const rootPages: typeof pages = [];

for (const p of pages) {
  const pathParts = p.path.split('/');
  if (pathParts.length > 1) {
    const cat = pathParts[0];
    if (!categoryMap.has(cat)) categoryMap.set(cat, []);
    categoryMap.get(cat)!.push(p);
  } else {
    rootPages.push(p);
  }
}

const categories: CategoryGroup[] = [...categoryMap.entries()]
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([name, catPages]) => ({
    name,
    pages: catPages,
    ...(CATEGORY_STYLES[name] || DEFAULT_STYLE),
  }));

// Total wikilink count
const totalLinks = pages.reduce((sum, p) => sum + (p.wikilinks?.length || 0), 0);

// Build backlinks map
const backlinksMap = new Map<string, string[]>();
for (const p of pages) {
  for (const link of (p.wikilinks || [])) {
    const target = link.endsWith('.md') ? link : link + '.md';
    if (!backlinksMap.has(target)) backlinksMap.set(target, []);
    backlinksMap.get(target)!.push(p.path);
  }
}

// Recently updated pages (sorted by updated_at descending)
const recentPages = [...pages]
  .sort((a, b) => new Date(b.updated_at).getTime() - new Date(a.updated_at).getTime())
  .slice(0, 8);

// Most connected pages (by combined inbound + outbound links)
const mostConnected = [...pages]
  .map(p => ({
    ...p,
    connectionCount: (p.wikilinks?.length || 0) + (backlinksMap.get(p.path)?.length || 0),
  }))
  .sort((a, b) => b.connectionCount - a.connectionCount)
  .slice(0, 8);

// File viewing mode
const url = Astro.url;
const filePath = url.searchParams.get('file');
const fileLayer = url.searchParams.get('layer') || 'page';
const viewMode = url.searchParams.get('view') || 'dashboard';
let fileContent: any = null;
let fileRevisions: any[] = [];
let currentBacklinks: string[] = [];

if (filePath) {
  if (fileLayer === 'source') {
    fileContent = await getSource(wiki.id, filePath);
  } else {
    fileContent = await getPage(wiki.id, filePath);
    if (fileContent) {
      fileRevisions = await getPageRevisions(fileContent.id, 10);
      currentBacklinks = backlinksMap.get(filePath) || [];
    }
  }
}

// Get the page set for broken-link detection
const allPagePaths = new Set(pages.map(p => p.path));
const allPageNames = new Set(pages.map(p => p.path.replace(/\.md$/, '')));

function timeAgo(dateStr: string): string {
  try {
    const d = new Date(dateStr);
    const diff = Date.now() - d.getTime();
    const mins = Math.floor(diff / 60000);
    if (mins < 1) return 'just now';
    if (mins < 60) return `${mins}m ago`;
    const hours = Math.floor(mins / 60);
    if (hours < 24) return `${hours}h ago`;
    const days = Math.floor(hours / 24);
    if (days < 7) return `${days}d ago`;
    if (days < 30) return `${Math.floor(days / 7)}w ago`;
    return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
  } catch { return dateStr; }
}

function escapeHtml(str: string): string {
  return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

/**
 * Enhanced markdown renderer -- parses content into structured, scannable HTML.
 * Handles: tables, key-value pairs, blockquote callouts, headings with anchors,
 * wikilinks, code blocks, lists, bold/italic, horizontal rules.
 */
function renderContent(content: string): string {
  // Do NOT escape upfront — markdown syntax uses #, *, >, | which would break parsing
  // Escaping happens in processInline() on text content only
  const lines = content.split('\n');
  let html = '';
  let inCodeBlock = false;
  let inList = false;
  let listType: 'ul' | 'ol' = 'ul';
  let inTable = false;
  let tableRows: string[][] = [];
  let inBlockquote = false;
  let blockquoteLines: string[] = [];
  let inKvBlock = false;
  let kvPairs: { key: string; value: string }[] = [];

  function flushTable() {
    if (tableRows.length === 0) return;
    html += '<div class="wiki-table-wrap"><table class="wiki-table">';
    tableRows.forEach((cols, rowIdx) => {
      const tag = rowIdx === 0 ? 'th' : 'td';
      html += '<tr>';
      cols.forEach(col => {
        html += `<${tag}>${processInline(col.trim())}</${tag}>`;
      });
      html += '</tr>';
    });
    html += '</table></div>';
    tableRows = [];
    inTable = false;
  }

  function flushBlockquote() {
    if (blockquoteLines.length === 0) return;
    const text = blockquoteLines.join(' ');
    // Detect callout type from content
    const lowerText = text.toLowerCase();
    let calloutType = 'info';
    if (lowerText.includes('warning') || lowerText.includes('caution') || lowerText.includes('attention') || lowerText.includes('deadline') || lowerText.includes('expir')) {
      calloutType = 'warning';
    } else if (lowerText.includes('important') || lowerText.includes('urgent') || lowerText.includes('critical') || lowerText.includes('action required')) {
      calloutType = 'danger';
    } else if (lowerText.includes('note') || lowerText.includes('tip') || lowerText.includes('remember')) {
      calloutType = 'info';
    } else if (lowerText.includes('success') || lowerText.includes('approved') || lowerText.includes('completed') || lowerText.includes('done')) {
      calloutType = 'success';
    }
    const icons: Record<string, string> = {
      info: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>',
      warning: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>',
      danger: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M15 9l-6 6"/><path d="M9 9l6 6"/></svg>',
      success: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>',
    };
    html += `<div class="wiki-callout callout-${calloutType}"><span class="callout-icon">${icons[calloutType]}</span><div class="callout-text">${processInline(text)}</div></div>`;
    blockquoteLines = [];
    inBlockquote = false;
  }

  function flushKv() {
    if (kvPairs.length === 0) return;
    html += '<div class="wiki-kv-grid">';
    kvPairs.forEach(({ key, value }) => {
      // Detect status-like values for badge coloring
      const lowerVal = value.toLowerCase();
      let badgeClass = '';
      if (/\b(active|current|approved|valid|yes|complete|done)\b/.test(lowerVal)) badgeClass = 'kv-badge-green';
      else if (/\b(pending|upcoming|attention|expires?|renew|soon|conditional)\b/.test(lowerVal)) badgeClass = 'kv-badge-amber';
      else if (/\b(expired|urgent|overdue|denied|no|failed|critical)\b/.test(lowerVal)) badgeClass = 'kv-badge-red';

      html += `<div class="wiki-kv-item"><span class="wiki-kv-key">${processInline(key)}</span><span class="wiki-kv-value${badgeClass ? ` ${badgeClass}` : ''}">${processInline(value)}</span></div>`;
    });
    html += '</div>';
    kvPairs = [];
    inKvBlock = false;
  }

  for (let i = 0; i < lines.length; i++) {
    let line = lines[i];

    // Code blocks
    if (line.startsWith('```')) {
      // Flush any open structures
      if (inBlockquote) flushBlockquote();
      if (inKvBlock) flushKv();
      if (inTable) flushTable();
      if (inList) { html += listType === 'ul' ? '</ul>' : '</ol>'; inList = false; }

      if (inCodeBlock) {
        html += '</code></pre>';
        inCodeBlock = false;
      } else {
        const lang = line.slice(3).trim();
        html += `<pre class="wiki-code-block"><code${lang ? ` data-lang="${lang}"` : ''}>`;
        inCodeBlock = true;
      }
      continue;
    }
    if (inCodeBlock) {
      html += line + '\n';
      continue;
    }

    // Table rows: | col | col | col |
    const tableMatch = line.match(/^\|(.+)\|$/);
    if (tableMatch) {
      // Flush other structures
      if (inBlockquote) flushBlockquote();
      if (inKvBlock) flushKv();
      if (inList) { html += listType === 'ul' ? '</ul>' : '</ol>'; inList = false; }

      const cells = tableMatch[1].split('|');
      // Skip separator rows like |---|---|
      if (cells.every(c => /^\s*-+\s*$/.test(c) || /^\s*:?-+:?\s*$/.test(c))) {
        if (!inTable && tableRows.length > 0) {
          inTable = true;
        }
        continue;
      }
      tableRows.push(cells);
      inTable = true;
      continue;
    } else if (inTable) {
      flushTable();
    }

    // Blockquotes: > text
    const bqMatch = line.match(/^>\s*(.*)$/);
    if (bqMatch) {
      if (inKvBlock) flushKv();
      if (inList) { html += listType === 'ul' ? '</ul>' : '</ol>'; inList = false; }
      inBlockquote = true;
      if (bqMatch[1].trim()) blockquoteLines.push(bqMatch[1].trim());
      continue;
    } else if (inBlockquote) {
      flushBlockquote();
    }

    // Key-value detection: **Key:** Value or **Key**: Value
    const kvMatch = line.match(/^\s*\*\*(.+?)\*\*\s*[:：]\s*(.+)$/);
    if (kvMatch) {
      if (inList) { html += listType === 'ul' ? '</ul>' : '</ol>'; inList = false; }
      inKvBlock = true;
      kvPairs.push({ key: kvMatch[1], value: kvMatch[2] });
      continue;
    } else if (inKvBlock) {
      // Also catch continuation of kv-like patterns with just bold labels
      // But if we hit a non-kv line, flush
      flushKv();
    }

    // Close list if this line isn't a list item
    if (inList && !line.match(/^\s*[-*]\s/) && !line.match(/^\s*\d+\.\s/) && line.trim() !== '') {
      html += listType === 'ul' ? '</ul>' : '</ol>';
      inList = false;
    }

    // Horizontal rule
    if (line.match(/^---+$/)) {
      html += '<hr class="wiki-hr" />';
      continue;
    }

    // Headings -- with anchor IDs for TOC
    const headingMatch = line.match(/^(#{1,4})\s+(.+)$/);
    if (headingMatch) {
      const level = headingMatch[1].length;
      const rawText = headingMatch[2];
      const text = processInline(rawText);
      const anchorId = rawText.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
      html += `<h${level + 1} id="${anchorId}" class="wiki-heading wiki-h${level}">${text}</h${level + 1}>`;
      continue;
    }

    // Unordered list items
    const ulMatch = line.match(/^\s*[-*]\s+(.+)$/);
    if (ulMatch) {
      if (!inList || listType !== 'ul') {
        if (inList) html += listType === 'ul' ? '</ul>' : '</ol>';
        html += '<ul class="wiki-list">';
        inList = true;
        listType = 'ul';
      }
      html += `<li>${processInline(ulMatch[1])}</li>`;
      continue;
    }

    // Ordered list items
    const olMatch = line.match(/^\s*\d+\.\s+(.+)$/);
    if (olMatch) {
      if (!inList || listType !== 'ol') {
        if (inList) html += listType === 'ul' ? '</ul>' : '</ol>';
        html += '<ol class="wiki-list">';
        inList = true;
        listType = 'ol';
      }
      html += `<li>${processInline(olMatch[1])}</li>`;
      continue;
    }

    // Empty line
    if (line.trim() === '') {
      if (inList) {
        html += listType === 'ul' ? '</ul>' : '</ol>';
        inList = false;
      }
      html += '<div class="wiki-spacer"></div>';
      continue;
    }

    // Regular paragraph
    html += `<p class="wiki-p">${processInline(line)}</p>`;
  }

  // Close any remaining open structures
  if (inCodeBlock) html += '</code></pre>';
  if (inList) html += listType === 'ul' ? '</ul>' : '</ol>';
  if (inBlockquote) flushBlockquote();
  if (inTable) flushTable();
  if (inKvBlock) flushKv();

  return html;
}

function processInline(text: string): string {
  // Extract wikilinks and inline code first (protect from escaping)
  const placeholders: string[] = [];
  function placeholder(html: string): string {
    placeholders.push(html);
    return `\x00PH${placeholders.length - 1}\x00`;
  }

  // Wikilinks
  text = text.replace(/\[\[(.+?)\]\]/g, (match, inner) => {
    const [target, display] = inner.split('|');
    const label = (display || target).trim();
    const normalizedTarget = target.trim().endsWith('.md') ? target.trim() : target.trim() + '.md';
    const href = `/wikis/${fullSlug}?file=${encodeURIComponent(normalizedTarget)}`;
    const exists = allPagePaths.has(normalizedTarget) || allPageNames.has(target.trim());
    const cls = exists ? 'wikilink' : 'wikilink wikilink-broken';
    return placeholder(`<a href="${escapeHtml(href)}" class="${cls}">${escapeHtml(label)}</a>`);
  });

  // Inline code (protect from escaping)
  text = text.replace(/`(.+?)`/g, (_, code) => {
    return placeholder(`<code class="wiki-inline-code">${escapeHtml(code)}</code>`);
  });

  // Now escape the remaining text for XSS safety
  text = escapeHtml(text);

  // Bold
  text = text.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
  // Italic
  text = text.replace(/\*(.+?)\*/g, '<em>$1</em>');

  // Restore placeholders
  text = text.replace(/\x00PH(\d+)\x00/g, (_, idx) => placeholders[parseInt(idx)]);

  return text;
}

function getPageDisplayName(path: string): string {
  const name = path.split('/').pop() || path;
  return name.replace(/\.md$/, '').replace(/-/g, ' ');
}

function getCategoryFromPath(path: string): string {
  const parts = path.split('/');
  return parts.length > 1 ? parts[0] : '';
}

function getCategoryIcon(category: string): string {
  const icons: Record<string, string> = {
    identity: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>',
    finances: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M12 8v8"/><path d="M8 12h8"/></svg>',
    investing: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>',
    business: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/></svg>',
    personal: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>',
    family: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>',
    people: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>',
    projects: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="M12 15l-3-3"/><path d="M22 2L13.34 10.66"/><path d="M16.5 2.5a2.12 2.12 0 0 1 3 3l-7 7H9v-3.5l7-7z"/></svg>',
    work: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>',
  };
  return icons[category] || '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>';
}

/**
 * Extract structured quick-facts from a page's content.
 * Looks for **Key:** Value patterns in the first ~30 lines.
 */
function extractQuickFacts(content: string): { key: string; value: string }[] {
  const facts: { key: string; value: string }[] = [];
  const lines = content.split('\n').slice(0, 40);
  for (const line of lines) {
    const match = line.match(/^\s*\*\*(.+?)\*\*\s*[:：]\s*(.+)/);
    if (match) {
      facts.push({ key: match[1].trim(), value: match[2].trim() });
    }
  }
  return facts.slice(0, 10);
}

/**
 * Extract section headings from markdown content for the TOC.
 */
function extractHeadings(content: string): { level: number; text: string; id: string }[] {
  const headings: { level: number; text: string; id: string }[] = [];
  for (const line of content.split('\n')) {
    const match = line.match(/^(#{1,3})\s+(.+)$/);
    if (match) {
      const text = match[2].replace(/\*\*/g, '').replace(/\[\[(.+?\|)?(.+?)\]\]/g, '$2');
      const id = text.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
      headings.push({ level: match[1].length, text, id });
    }
  }
  return headings;
}

/**
 * Get first paragraph of content (skip headings, blank lines, kv pairs)
 */
function getPageSummary(content: string, maxLen = 120): string {
  const lines = content.split('\n');
  for (const line of lines) {
    const trimmed = line.trim();
    if (
      trimmed &&
      !trimmed.startsWith('#') &&
      !trimmed.startsWith('---') &&
      !trimmed.startsWith('```') &&
      !trimmed.startsWith('>') &&
      !trimmed.startsWith('|') &&
      !trimmed.match(/^\*\*.*\*\*\s*[:：]/)
    ) {
      return trimmed.length > maxLen ? trimmed.slice(0, maxLen) + '...' : trimmed;
    }
  }
  return '';
}

/**
 * Detect status badge color from a value string
 */
function getStatusColor(value: string): string {
  const lower = value.toLowerCase();
  if (/\b(active|current|approved|valid|complete|done|yes)\b/.test(lower)) return 'green';
  if (/\b(pending|upcoming|attention|expires?|renew|conditional|soon|review)\b/.test(lower)) return 'amber';
  if (/\b(expired|urgent|overdue|denied|failed|critical|no)\b/.test(lower)) return 'red';
  return '';
}

const pageTitle = fileContent
  ? `${getPageDisplayName(filePath!)} -- ${wiki.slug}`
  : `${wiki.slug} -- Your Brain`;

// Category section order for the main page
const SECTION_ORDER = [
  { key: 'identity', label: 'Identity & Immigration', summary: 'Documents, legal status, immigration records' },
  { key: 'work', label: 'Career & Work', summary: 'Current role, employment history, compensation' },
  { key: 'business', label: 'Business & Companies', summary: 'Ventures, entities, business plans' },
  { key: 'finances', label: 'Finances & Investments', summary: 'Accounts, budgets, financial planning' },
  { key: 'investing', label: 'Investing', summary: 'Portfolio, strategy, market analysis' },
  { key: 'people', label: 'People & Relationships', summary: 'Contacts, relationships, network' },
  { key: 'family', label: 'Family', summary: 'Loved ones, family plans, memories' },
  { key: 'personal', label: 'Personal Life', summary: 'Health, goals, habits, lifestyle' },
  { key: 'projects', label: 'Projects & Technology', summary: 'What you are building, tech stack' },
];

// Build ordered sections matching available categories
const orderedSections = SECTION_ORDER
  .filter(s => categoryMap.has(s.key))
  .map(s => ({
    ...s,
    category: categories.find(c => c.name === s.key)!,
  }));

// Preload summaries for section descriptions
const categorySummaries = new Map<string, string>();
for (const cat of categories) {
  if (cat.pages.length > 0) {
    const firstPage = await getPage(wiki.id, cat.pages[0].path);
    if (firstPage) {
      categorySummaries.set(cat.name, getPageSummary(firstPage.content));
    }
  }
}

// Extract headings for page TOC
const pageHeadings = fileContent && fileLayer !== 'source'
  ? extractHeadings(fileContent.content)
  : [];

// Extract quick facts for page view
const quickFacts = fileContent && fileLayer !== 'source'
  ? extractQuickFacts(fileContent.content)
  : [];
---

<Layout title={pageTitle}>
  <div class="wiki-shell">

    {/* ============================================= */}
    {/* TOP NAVIGATION BAR                            */}
    {/* ============================================= */}
    <nav class="wiki-nav">
      <div class="wiki-nav-left">
        {fileContent || viewMode === 'graph' ? (
          <a href={`/wikis/${fullSlug}`} class="nav-back" title="Back to wiki home">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/></svg>
          </a>
        ) : null}
        <a href={`/wikis/${fullSlug}`} class="nav-title">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          <span>{wiki.slug.split('/').pop()}</span>
        </a>
        {fileContent && (
          <span class="nav-breadcrumb">
            <span class="nav-sep">/</span>
            {getCategoryFromPath(filePath!) && (
              <>
                <span class="nav-crumb-cat" style={`color: ${(CATEGORY_STYLES[getCategoryFromPath(filePath!)] || DEFAULT_STYLE).color}`}>{getCategoryFromPath(filePath!)}</span>
                <span class="nav-sep">/</span>
              </>
            )}
            <span class="nav-crumb-page">{getPageDisplayName(filePath!)}</span>
          </span>
        )}
      </div>
      <div class="wiki-nav-right">
        <div class="nav-search" id="nav-search">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
          <input type="text" placeholder="Search pages..." id="nav-search-input" autocomplete="off" />
          <kbd>/</kbd>
          <div class="nav-search-results" id="nav-search-results"></div>
        </div>
        {!fileContent && viewMode !== 'graph' && (
          <a href={`/wikis/${fullSlug}?view=graph`} class="nav-icon-btn" title="Knowledge graph">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="2"/><circle cx="6" cy="6" r="2"/><circle cx="18" cy="6" r="2"/><circle cx="6" cy="18" r="2"/><circle cx="18" cy="18" r="2"/><path d="M12 10V8"/><path d="M6.3 7.7l3.4 2.6"/><path d="M17.7 7.7l-3.4 2.6"/><path d="M6.3 16.3l3.4-2.6"/><path d="M17.7 16.3l-3.4-2.6"/></svg>
          </a>
        )}
      </div>
    </nav>

    {viewMode === 'graph' && !filePath ? (
      <!-- ============================================= -->
      <!-- GRAPH VIEW                                    -->
      <!-- ============================================= -->
      <div class="wiki-graph" id="wiki-graph">
        <canvas id="wiki-graph-canvas"></canvas>
        <div class="graph-legend" id="wiki-graph-legend">
          <h4 class="legend-title">Categories</h4>
          {categories.map(cat => (
            <div class="legend-row">
              <span class="legend-dot" style={`background: ${cat.color}; box-shadow: 0 0 6px ${cat.color}88`}></span>
              <span class="legend-name">{cat.name}</span>
              <span class="legend-count">{cat.pages.length}</span>
            </div>
          ))}
        </div>
        <div class="graph-controls">
          <button class="graph-ctrl-btn" id="wiki-graph-reset">Reset</button>
          <button class="graph-ctrl-btn" id="wiki-graph-labels">Labels</button>
        </div>
        <div class="graph-info" id="wiki-graph-info"></div>
      </div>

    ) : fileContent ? (
      <!-- ============================================= -->
      <!-- PAGE VIEW -- Wikipedia-style article          -->
      <!-- ============================================= -->
      <div class="page-layout">
        {/* Sticky TOC sidebar (desktop) */}
        {pageHeadings.length > 2 && (
          <aside class="page-toc-sidebar">
            <div class="page-toc-sticky">
              <h4 class="toc-label">Contents</h4>
              <nav class="toc-nav">
                {pageHeadings.map((h, i) => (
                  <a href={`#${h.id}`} class={`toc-link toc-level-${h.level}`} data-toc-id={h.id}>
                    {h.text}
                  </a>
                ))}
              </nav>
            </div>
          </aside>
        )}

        <article class="page-article">
          {/* Page header */}
          <header class="page-header">
            {getCategoryFromPath(filePath!) && (
              <a href={`/wikis/${fullSlug}`} class="page-cat-badge" style={`--cat-color: ${(CATEGORY_STYLES[getCategoryFromPath(filePath!)] || DEFAULT_STYLE).color}`}>
                <span class="page-cat-icon" set:html={getCategoryIcon(getCategoryFromPath(filePath!))} />
                <span>{getCategoryFromPath(filePath!)}</span>
              </a>
            )}
            <h1 class="page-title">{getPageDisplayName(filePath!)}</h1>
            <div class="page-meta">
              {fileLayer === 'source' ? (
                <span class="page-meta-tag source">Source file</span>
              ) : (
                <span class="page-meta-tag">v{fileContent.revision}</span>
              )}
              <span class="page-meta-text">Updated {timeAgo(fileContent.updated_at || fileContent.created_at)}</span>
              {fileContent.wikilinks?.length > 0 && (
                <span class="page-meta-text">{fileContent.wikilinks.length} link{fileContent.wikilinks.length !== 1 ? 's' : ''}</span>
              )}
              {currentBacklinks.length > 0 && (
                <span class="page-meta-text">{currentBacklinks.length} backlink{currentBacklinks.length !== 1 ? 's' : ''}</span>
              )}
            </div>
          </header>

          {/* Quick Facts card -- only if kv pairs detected */}
          {quickFacts.length > 0 && (
            <div class="quick-facts-card">
              <div class="quick-facts-header">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>
                <span>Quick Facts</span>
              </div>
              <div class="quick-facts-grid">
                {quickFacts.map(fact => {
                  const statusColor = getStatusColor(fact.value);
                  return (
                    <div class="quick-fact-row">
                      <span class="quick-fact-key">{fact.key}</span>
                      <span class={`quick-fact-value${statusColor ? ` status-${statusColor}` : ''}`} set:html={processInline(fact.value)} />
                    </div>
                  );
                })}
              </div>
            </div>
          )}

          {/* Mobile TOC (below header) */}
          {pageHeadings.length > 2 && (
            <details class="page-toc-mobile">
              <summary class="toc-mobile-toggle">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12h18"/><path d="M3 6h18"/><path d="M3 18h18"/></svg>
                Table of Contents
                <svg class="toc-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
              </summary>
              <nav class="toc-mobile-nav">
                {pageHeadings.map(h => (
                  <a href={`#${h.id}`} class={`toc-link toc-level-${h.level}`}>{h.text}</a>
                ))}
              </nav>
            </details>
          )}

          {/* Content body */}
          <div class="page-body">
            {fileLayer === 'source' ? (
              <pre class="page-raw-source">{fileContent.content}</pre>
            ) : (
              <div class="page-content" set:html={renderContent(fileContent.content)} />
            )}
          </div>

          {/* Outgoing links (wikilinks in this page) */}
          {fileContent.wikilinks?.length > 0 && fileLayer !== 'source' && (
            <section class="page-section page-links">
              <h3 class="page-section-heading">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                Links from this page
              </h3>
              <div class="link-chips">
                {fileContent.wikilinks.map((link: string) => {
                  const target = link.endsWith('.md') ? link : link + '.md';
                  const exists = allPagePaths.has(target) || allPageNames.has(link);
                  const cat = getCategoryFromPath(target);
                  const catColor = (CATEGORY_STYLES[cat] || DEFAULT_STYLE).color;
                  return (
                    <a
                      href={exists ? `/wikis/${fullSlug}?file=${encodeURIComponent(target)}` : '#'}
                      class:list={['link-chip', { broken: !exists }]}
                      style={`--chip-color: ${catColor}`}
                    >
                      <span class="chip-dot" style={`background: ${catColor}`}></span>
                      {getPageDisplayName(target)}
                      {!exists && <span class="chip-missing">missing</span>}
                    </a>
                  );
                })}
              </div>
            </section>
          )}

          {/* Backlinks */}
          {currentBacklinks.length > 0 && (
            <section class="page-section page-links">
              <h3 class="page-section-heading">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 7h3a5 5 0 0 1 5 5 5 5 0 0 1-5 5h-3m-6 0H6a5 5 0 0 1-5-5 5 5 0 0 1 5-5h3"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
                Pages that link here
              </h3>
              <div class="link-chips">
                {currentBacklinks.map(bl => {
                  const cat = getCategoryFromPath(bl);
                  const catColor = (CATEGORY_STYLES[cat] || DEFAULT_STYLE).color;
                  return (
                    <a href={`/wikis/${fullSlug}?file=${encodeURIComponent(bl)}`} class="link-chip" style={`--chip-color: ${catColor}`}>
                      <span class="chip-dot" style={`background: ${catColor}`}></span>
                      {getPageDisplayName(bl)}
                    </a>
                  );
                })}
              </div>
            </section>
          )}

          {/* Revision history */}
          {fileRevisions.length > 1 && (
            <section class="page-section page-revisions">
              <h3 class="page-section-heading">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                Version history
              </h3>
              <div class="revision-timeline">
                {fileRevisions.map((rev: any, i: number) => (
                  <div class:list={['rev-row', { current: i === 0 }]}>
                    <div class="rev-marker">
                      <div class="rev-dot"></div>
                      {i < fileRevisions.length - 1 && <div class="rev-line"></div>}
                    </div>
                    <div class="rev-info">
                      <div class="rev-top">
                        <span class="rev-v">v{rev.revision}</span>
                        <span class="rev-msg">{rev.message || 'Updated'}</span>
                      </div>
                      <div class="rev-bottom">
                        <span>by {rev.pushed_by}</span>
                        <span>{timeAgo(rev.created_at)}</span>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </section>
          )}
        </article>
      </div>

    ) : (
      <!-- ============================================= -->
      <!-- MAIN PAGE -- Wikipedia-style encyclopedia     -->
      <!-- ============================================= -->
      <div class="wiki-home">

        {/* Wikipedia-style intro */}
        <header class="wiki-intro">
          <h1 class="wiki-main-title">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
            {wiki.slug.split('/').pop()}'s Wiki
          </h1>
          <p class="wiki-intro-text">
            A personal knowledge base with <strong>{stats.page_count} pages</strong> across <strong>{categories.length} categories</strong>, connected by <strong>{totalLinks} wikilinks</strong>. Last updated {recentPages.length > 0 ? timeAgo(recentPages[0].updated_at) : 'recently'}.
          </p>
        </header>

        {/* Spotlight search */}
        <div class="wiki-search-bar" id="spotlight">
          <svg class="search-bar-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
          <input type="text" class="search-bar-input" placeholder="Search your wiki..." id="spotlight-input" autocomplete="off" />
          <kbd class="search-bar-kbd">/</kbd>
          <div class="search-bar-results" id="spotlight-results"></div>
        </div>

        <div class="wiki-main-layout">
          {/* ── Main content column ── */}
          <div class="wiki-main-col">

            {/* Table of contents */}
            <nav class="wiki-toc-card">
              <h2 class="toc-card-title">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12h18"/><path d="M3 6h18"/><path d="M3 18h18"/></svg>
                Contents
              </h2>
              <ol class="toc-card-list">
                {orderedSections.map((section, i) => (
                  <li>
                    <a href={`#section-${section.key}`} class="toc-card-link">
                      <span class="toc-num">{i + 1}</span>
                      <span class="toc-text">{section.label}</span>
                      <span class="toc-count">{section.category.pages.length}</span>
                    </a>
                  </li>
                ))}
                {rootPages.length > 0 && (
                  <li>
                    <a href="#section-other" class="toc-card-link">
                      <span class="toc-num">{orderedSections.length + 1}</span>
                      <span class="toc-text">Other Pages</span>
                      <span class="toc-count">{rootPages.length}</span>
                    </a>
                  </li>
                )}
              </ol>
            </nav>

            {/* Content sections -- each category as a wiki section */}
            {orderedSections.map((section, sectionIdx) => {
              const cat = section.category;
              const summary = categorySummaries.get(cat.name) || '';
              const catStyle = CATEGORY_STYLES[cat.name] || DEFAULT_STYLE;
              return (
                <section class="wiki-section" id={`section-${section.key}`}>
                  <div class="wiki-section-header" style={`--section-color: ${catStyle.color}`}>
                    <div class="section-icon-wrap" style={`background: ${catStyle.color}12; color: ${catStyle.color}`} set:html={getCategoryIcon(cat.name)} />
                    <div class="section-title-group">
                      <h2 class="wiki-section-title">{section.label}</h2>
                      <p class="wiki-section-desc">{section.summary}</p>
                    </div>
                    <span class="section-page-count">{cat.pages.length} page{cat.pages.length !== 1 ? 's' : ''}</span>
                  </div>

                  {summary && <p class="wiki-section-summary">{summary}</p>}

                  <div class="wiki-section-pages">
                    {cat.pages.map(p => {
                      const linkCount = (p.wikilinks?.length || 0) + (backlinksMap.get(p.path)?.length || 0);
                      return (
                        <a href={`/wikis/${fullSlug}?file=${encodeURIComponent(p.path)}`} class="wiki-page-row" style={`--row-color: ${catStyle.color}`}>
                          <span class="page-row-dot" style={`background: ${catStyle.color}`}></span>
                          <span class="page-row-name">{getPageDisplayName(p.path)}</span>
                          {linkCount > 0 && (
                            <span class="page-row-links" title={`${linkCount} connections`}>
                              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
                              {linkCount}
                            </span>
                          )}
                          <span class="page-row-time">{timeAgo(p.updated_at)}</span>
                          <svg class="page-row-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
                        </a>
                      );
                    })}
                  </div>
                </section>
              );
            })}

            {/* Root-level pages */}
            {rootPages.length > 0 && (
              <section class="wiki-section" id="section-other">
                <div class="wiki-section-header" style="--section-color: #a1a1aa">
                  <div class="section-icon-wrap" style="background: rgba(161,161,170,0.08); color: #a1a1aa">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
                  </div>
                  <div class="section-title-group">
                    <h2 class="wiki-section-title">Other Pages</h2>
                    <p class="wiki-section-desc">Uncategorized pages</p>
                  </div>
                  <span class="section-page-count">{rootPages.length} page{rootPages.length !== 1 ? 's' : ''}</span>
                </div>
                <div class="wiki-section-pages">
                  {rootPages.map(p => (
                    <a href={`/wikis/${fullSlug}?file=${encodeURIComponent(p.path)}`} class="wiki-page-row" style="--row-color: #a1a1aa">
                      <span class="page-row-dot" style="background: #a1a1aa"></span>
                      <span class="page-row-name">{getPageDisplayName(p.path)}</span>
                      <span class="page-row-time">{timeAgo(p.updated_at)}</span>
                      <svg class="page-row-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
                    </a>
                  ))}
                </div>
              </section>
            )}
          </div>

          {/* ── Right sidebar (infobox) ── */}
          <aside class="wiki-sidebar">
            {/* Infobox */}
            <div class="wiki-infobox">
              <div class="infobox-photo">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" opacity="0.3"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
              </div>
              <h3 class="infobox-name">{wiki.slug.split('/').pop()}</h3>
              <div class="infobox-subtitle">Personal Encyclopedia</div>
              <div class="infobox-stats">
                <div class="infobox-stat">
                  <span class="infobox-stat-num">{stats.page_count}</span>
                  <span class="infobox-stat-label">Pages</span>
                </div>
                <div class="infobox-stat">
                  <span class="infobox-stat-num">{categories.length}</span>
                  <span class="infobox-stat-label">Categories</span>
                </div>
                <div class="infobox-stat">
                  <span class="infobox-stat-num">{totalLinks}</span>
                  <span class="infobox-stat-label">Links</span>
                </div>
              </div>
              <div class="infobox-divider"></div>
              <div class="infobox-facts">
                {categories.map(cat => {
                  const catStyle = CATEGORY_STYLES[cat.name] || DEFAULT_STYLE;
                  return (
                    <div class="infobox-fact-row">
                      <span class="infobox-fact-dot" style={`background: ${catStyle.color}`}></span>
                      <span class="infobox-fact-key">{cat.name}</span>
                      <span class="infobox-fact-value">{cat.pages.length}</span>
                    </div>
                  );
                })}
              </div>
            </div>

            {/* Quick Links -- most connected */}
            {mostConnected.length > 0 && (
              <div class="sidebar-card">
                <h4 class="sidebar-card-title">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                  Most Connected
                </h4>
                <div class="sidebar-list">
                  {mostConnected.slice(0, 6).map(p => {
                    const cat = getCategoryFromPath(p.path);
                    const catColor = (CATEGORY_STYLES[cat] || DEFAULT_STYLE).color;
                    return (
                      <a href={`/wikis/${fullSlug}?file=${encodeURIComponent(p.path)}`} class="sidebar-link">
                        <span class="sidebar-link-dot" style={`background: ${catColor}`}></span>
                        <span class="sidebar-link-name">{getPageDisplayName(p.path)}</span>
                        <span class="sidebar-link-count">{p.connectionCount}</span>
                      </a>
                    );
                  })}
                </div>
              </div>
            )}

            {/* Recently updated */}
            <div class="sidebar-card">
              <h4 class="sidebar-card-title">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                Recently Updated
              </h4>
              <div class="sidebar-list">
                {recentPages.slice(0, 6).map(p => {
                  const cat = getCategoryFromPath(p.path);
                  const catColor = (CATEGORY_STYLES[cat] || DEFAULT_STYLE).color;
                  return (
                    <a href={`/wikis/${fullSlug}?file=${encodeURIComponent(p.path)}`} class="sidebar-link">
                      <span class="sidebar-link-dot" style={`background: ${catColor}`}></span>
                      <span class="sidebar-link-name">{getPageDisplayName(p.path)}</span>
                      <span class="sidebar-link-time">{timeAgo(p.updated_at)}</span>
                    </a>
                  );
                })}
              </div>
            </div>

            {/* Recent activity */}
            {recentLog.length > 0 && (
              <div class="sidebar-card">
                <h4 class="sidebar-card-title">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                  Activity
                </h4>
                <div class="sidebar-activity">
                  {recentLog.slice(0, 5).map(entry => (
                    <div class="sidebar-activity-row">
                      <span class:list={['sidebar-op', `op-${entry.operation}`]}>{entry.operation}</span>
                      <span class="sidebar-activity-text">{entry.summary}</span>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </aside>
        </div>
      </div>
    )}
  </div>
</Layout>

<script define:vars={{ pages: pages.map(p => ({ path: p.path, wikilinks: p.wikilinks })), fullSlug, categories: categories.map(c => ({ name: c.name, color: c.color, pages: c.pages.map(p => ({ path: p.path, wikilinks: p.wikilinks })) })) }}>
document.addEventListener('DOMContentLoaded', () => {

  // ── Search (shared between nav and spotlight) ──
  function setupSearch(inputId, resultsId) {
    const input = document.getElementById(inputId);
    const results = document.getElementById(resultsId);
    if (!input || !results) return;

    let debounce;

    input.addEventListener('input', (e) => {
      clearTimeout(debounce);
      const query = e.target.value.trim().toLowerCase();

      if (query.length < 2) {
        results.classList.remove('visible');
        return;
      }

      debounce = setTimeout(() => {
        const matches = pages.filter(p => {
          const name = p.path.toLowerCase().replace(/[\/\-_\.]/g, ' ');
          return name.includes(query) || p.path.toLowerCase().includes(query);
        }).slice(0, 8);

        results.textContent = '';

        if (matches.length === 0) {
          const empty = document.createElement('div');
          empty.className = 'search-empty';
          empty.textContent = 'No pages found';
          results.appendChild(empty);
        } else {
          matches.forEach(p => {
            const displayName = p.path.split('/').pop().replace(/\.md$/, '').replace(/-/g, ' ');
            const cat = p.path.includes('/') ? p.path.split('/')[0] : '';

            const link = document.createElement('a');
            link.href = '/wikis/' + fullSlug + '?file=' + encodeURIComponent(p.path);
            link.className = 'search-result-item';

            if (cat) {
              const catSpan = document.createElement('span');
              catSpan.className = 'sr-cat';
              catSpan.textContent = cat;
              link.appendChild(catSpan);
            }

            const nameSpan = document.createElement('span');
            nameSpan.className = 'sr-name';
            nameSpan.textContent = displayName;
            link.appendChild(nameSpan);

            results.appendChild(link);
          });
        }
        results.classList.add('visible');
      }, 120);
    });

    input.addEventListener('blur', () => {
      setTimeout(() => results.classList.remove('visible'), 200);
    });

    input.addEventListener('focus', () => {
      if (input.value.trim().length >= 2) {
        results.classList.add('visible');
      }
    });
  }

  setupSearch('spotlight-input', 'spotlight-results');
  setupSearch('nav-search-input', 'nav-search-results');

  // Keyboard shortcut: / to focus search
  document.addEventListener('keydown', (e) => {
    const anyInput = document.activeElement && (document.activeElement.tagName === 'INPUT' || document.activeElement.tagName === 'TEXTAREA');
    if (e.key === '/' && !anyInput) {
      e.preventDefault();
      const spotlight = document.getElementById('spotlight-input');
      const navSearch = document.getElementById('nav-search-input');
      if (spotlight) spotlight.focus();
      else if (navSearch) navSearch.focus();
    }
    if (e.key === 'Escape') {
      if (document.activeElement?.tagName === 'INPUT') {
        document.activeElement.blur();
      }
      document.querySelectorAll('.search-bar-results, .nav-search-results').forEach(el => el.classList.remove('visible'));
    }
  });

  // ── TOC active state tracking ──
  const tocLinks = document.querySelectorAll('.toc-link[data-toc-id]');
  if (tocLinks.length > 0) {
    const headingEls = [];
    tocLinks.forEach(link => {
      const id = link.getAttribute('data-toc-id');
      const el = document.getElementById(id);
      if (el) headingEls.push({ el, link });
    });

    if (headingEls.length > 0) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            tocLinks.forEach(l => l.classList.remove('active'));
            const match = headingEls.find(h => h.el === entry.target);
            if (match) match.link.classList.add('active');
          }
        });
      }, { rootMargin: '-80px 0px -70% 0px', threshold: 0 });

      headingEls.forEach(({ el }) => observer.observe(el));
    }
  }

  // ── Smooth scroll for TOC links ──
  document.querySelectorAll('.toc-link, .toc-card-link').forEach(link => {
    link.addEventListener('click', (e) => {
      const href = link.getAttribute('href');
      if (href && href.startsWith('#')) {
        e.preventDefault();
        const target = document.getElementById(href.slice(1));
        if (target) {
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          history.replaceState(null, '', href);
        }
      }
    });
  });

  // ── Graph View ──
  const graphContainer = document.getElementById('wiki-graph');
  if (graphContainer) {
    const canvas = document.getElementById('wiki-graph-canvas');
    const ctx = canvas.getContext('2d');
    const infoEl = document.getElementById('wiki-graph-info');

    let W = 0, H = 0;
    let showLabels = true;
    let hoveredNode = null;
    let selectedNode = null;
    let dragNode = null;
    let isDragging = false;
    let isPanning = false;
    let panStart = { x: 0, y: 0, camX: 0, camY: 0 };
    let cam = { x: 0, y: 0, zoom: 1 };
    let animId;

    const catColorMap = {};
    categories.forEach(c => { catColorMap[c.name] = c.color; });

    const allPages = [];
    categories.forEach(c => c.pages.forEach(p => allPages.push(p)));

    const nodeMap = {};
    const spread = 300;

    const nodes = allPages.map((p, i) => {
      const cat = p.path.includes('/') ? p.path.split('/')[0] : '';
      const angle = (i / allPages.length) * Math.PI * 2;
      const linkCount = (p.wikilinks || []).length;
      const node = {
        id: p.path,
        label: p.path.split('/').pop().replace(/\.md$/, '').replace(/-/g, ' '),
        category: cat,
        color: catColorMap[cat] || '#a1a1aa',
        radius: Math.max(6, Math.min(16, 6 + linkCount * 1.5)),
        x: 500 + Math.cos(angle) * spread + (Math.random() - 0.5) * 100,
        y: 400 + Math.sin(angle) * spread + (Math.random() - 0.5) * 100,
        vx: 0, vy: 0,
        wikilinks: p.wikilinks || [],
      };
      nodeMap[p.path] = node;
      return node;
    });

    const edges = [];
    const edgeSet = new Set();
    for (const n of nodes) {
      for (const link of n.wikilinks) {
        const target = link.endsWith('.md') ? link : link + '.md';
        if (nodeMap[target]) {
          const key = [n.id, target].sort().join('::');
          if (!edgeSet.has(key)) {
            edgeSet.add(key);
            edges.push({ source: n.id, target: target });
          }
        }
      }
    }

    function resize() {
      W = graphContainer.clientWidth;
      H = graphContainer.clientHeight;
      canvas.width = W * devicePixelRatio;
      canvas.height = H * devicePixelRatio;
      canvas.style.width = W + 'px';
      canvas.style.height = H + 'px';
      ctx.setTransform(devicePixelRatio, 0, 0, devicePixelRatio, 0, 0);
    }

    function screenToWorld(sx, sy) {
      const rect = canvas.getBoundingClientRect();
      const cx = sx - rect.left, cy = sy - rect.top;
      return {
        x: (cx - W / 2) / cam.zoom + W / 2 - cam.x,
        y: (cy - H / 2) / cam.zoom + H / 2 - cam.y,
      };
    }

    const SPRING_LENGTH = 140, SPRING_STRENGTH = 0.005, REPULSION = 4000, DAMPING = 0.86, CENTER_GRAVITY = 0.0004;

    function simulate() {
      for (let i = 0; i < nodes.length; i++) {
        for (let j = i + 1; j < nodes.length; j++) {
          const a = nodes[i], b = nodes[j];
          const dx = b.x - a.x, dy = b.y - a.y;
          const dist = Math.sqrt(dx * dx + dy * dy) || 1;
          const force = REPULSION / (dist * dist);
          const fx = (dx / dist) * force, fy = (dy / dist) * force;
          a.vx -= fx; a.vy -= fy;
          b.vx += fx; b.vy += fy;
        }
      }

      for (const e of edges) {
        const a = nodeMap[e.source], b = nodeMap[e.target];
        if (!a || !b) continue;
        const dx = b.x - a.x, dy = b.y - a.y;
        const dist = Math.sqrt(dx * dx + dy * dy) || 1;
        const displacement = dist - SPRING_LENGTH;
        const force = displacement * SPRING_STRENGTH;
        const fx = (dx / dist) * force, fy = (dy / dist) * force;
        a.vx += fx; a.vy += fy;
        b.vx -= fx; b.vy -= fy;
      }

      const cx = W / 2, cy = H / 2;
      for (const n of nodes) {
        n.vx += (cx - n.x) * CENTER_GRAVITY;
        n.vy += (cy - n.y) * CENTER_GRAVITY;
      }

      for (const n of nodes) {
        if (n === dragNode) continue;
        n.vx *= DAMPING; n.vy *= DAMPING;
        n.x += n.vx; n.y += n.vy;
      }
    }

    function hexAlpha(hex, alpha) {
      const a = Math.round(alpha * 255).toString(16).padStart(2, '0');
      return hex + a;
    }

    function getConnected(nodeId) {
      const ids = {};
      for (const e of edges) {
        if (e.source === nodeId) ids[e.target] = true;
        if (e.target === nodeId) ids[e.source] = true;
      }
      return ids;
    }

    function draw() {
      ctx.clearRect(0, 0, W, H);
      const bg = ctx.createRadialGradient(W / 2, H / 2, 0, W / 2, H / 2, Math.max(W, H) * 0.6);
      bg.addColorStop(0, '#0e0e12');
      bg.addColorStop(1, '#08080b');
      ctx.fillStyle = bg;
      ctx.fillRect(0, 0, W, H);

      ctx.save();
      ctx.translate(W / 2, H / 2);
      ctx.scale(cam.zoom, cam.zoom);
      ctx.translate(-W / 2 + cam.x, -H / 2 + cam.y);

      const activeId = selectedNode ? selectedNode.id : (hoveredNode ? hoveredNode.id : null);
      const connectedIds = activeId ? getConnected(activeId) : null;

      for (const e of edges) {
        const a = nodeMap[e.source], b = nodeMap[e.target];
        if (!a || !b) continue;
        const isHighlighted = activeId && (e.source === activeId || e.target === activeId);
        const isDimmed = activeId && !isHighlighted;
        ctx.beginPath();
        ctx.moveTo(a.x, a.y);
        ctx.lineTo(b.x, b.y);
        if (isHighlighted) { ctx.strokeStyle = 'rgba(160,170,200,0.5)'; ctx.lineWidth = 2; }
        else if (isDimmed) { ctx.strokeStyle = 'rgba(60,60,80,0.08)'; ctx.lineWidth = 0.5; }
        else { ctx.strokeStyle = 'rgba(100,110,140,0.15)'; ctx.lineWidth = 1; }
        ctx.stroke();
      }

      for (const n of nodes) {
        const isActive = activeId === n.id;
        const isConnected = connectedIds && connectedIds[n.id];
        const isDimmed = activeId && !isActive && !isConnected;
        const r = n.radius;

        if (!isDimmed) {
          const glowSize = isActive ? r * 4 : (isConnected ? r * 3 : r * 2.2);
          const glowAlpha = isActive ? 0.3 : (isConnected ? 0.15 : 0.07);
          const grad = ctx.createRadialGradient(n.x, n.y, r * 0.3, n.x, n.y, glowSize);
          grad.addColorStop(0, hexAlpha(n.color, glowAlpha));
          grad.addColorStop(1, hexAlpha(n.color, 0));
          ctx.beginPath();
          ctx.arc(n.x, n.y, glowSize, 0, Math.PI * 2);
          ctx.fillStyle = grad;
          ctx.fill();
        }

        ctx.beginPath();
        ctx.arc(n.x, n.y, r, 0, Math.PI * 2);
        if (isDimmed) ctx.fillStyle = hexAlpha(n.color, 0.15);
        else if (isActive) ctx.fillStyle = hexAlpha(n.color, 0.9);
        else ctx.fillStyle = hexAlpha(n.color, 0.6);
        ctx.fill();

        if (!isDimmed) {
          ctx.strokeStyle = hexAlpha(n.color, isActive ? 0.9 : 0.3);
          ctx.lineWidth = isActive ? 2.5 : 1;
          ctx.stroke();
        }

        if (showLabels && !isDimmed) {
          ctx.font = '10px Inter, -apple-system, sans-serif';
          ctx.textAlign = 'center';
          ctx.fillStyle = isActive ? 'rgba(250,250,250,0.95)' : 'rgba(200,200,220,0.5)';
          const label = n.label.length > 20 ? n.label.slice(0, 18) + '..' : n.label;
          ctx.fillText(label, n.x, n.y + r + 14);
        }
      }
      ctx.restore();
    }

    function tick() {
      simulate();
      draw();
      infoEl.textContent = nodes.length + ' pages  |  ' + edges.length + ' connections';
      animId = requestAnimationFrame(tick);
    }

    function hitTest(mx, my) {
      const world = screenToWorld(mx, my);
      for (let i = nodes.length - 1; i >= 0; i--) {
        const n = nodes[i];
        const dx = world.x - n.x, dy = world.y - n.y;
        if (dx * dx + dy * dy < (n.radius + 4) * (n.radius + 4)) return n;
      }
      return null;
    }

    canvas.addEventListener('mousemove', (e) => {
      if (isPanning) {
        cam.x = panStart.camX + (e.clientX - panStart.x) / cam.zoom;
        cam.y = panStart.camY + (e.clientY - panStart.y) / cam.zoom;
        return;
      }
      if (dragNode) {
        isDragging = true;
        const world = screenToWorld(e.clientX, e.clientY);
        dragNode.x = world.x; dragNode.y = world.y;
        dragNode.vx = 0; dragNode.vy = 0;
        return;
      }
      hoveredNode = hitTest(e.clientX, e.clientY);
      canvas.style.cursor = hoveredNode ? 'pointer' : 'grab';
    });

    canvas.addEventListener('mousedown', (e) => {
      const hit = hitTest(e.clientX, e.clientY);
      if (hit) {
        dragNode = hit;
        isDragging = false;
        selectedNode = (selectedNode === hit) ? null : hit;
      } else {
        selectedNode = null;
        isPanning = true;
        panStart = { x: e.clientX, y: e.clientY, camX: cam.x, camY: cam.y };
        canvas.style.cursor = 'grabbing';
      }
    });

    canvas.addEventListener('mouseup', () => {
      if (dragNode && !isDragging) {
        window.location.href = '/wikis/' + fullSlug + '?file=' + encodeURIComponent(dragNode.id);
      }
      dragNode = null;
      isDragging = false;
      isPanning = false;
      canvas.style.cursor = hoveredNode ? 'pointer' : 'grab';
    });

    canvas.addEventListener('mouseleave', () => {
      hoveredNode = null; dragNode = null; isDragging = false; isPanning = false;
    });

    canvas.addEventListener('wheel', (e) => {
      e.preventDefault();
      const delta = e.deltaY > 0 ? 0.92 : 1.08;
      const newZoom = Math.max(0.3, Math.min(4, cam.zoom * delta));
      const before = screenToWorld(e.clientX, e.clientY);
      cam.zoom = newZoom;
      const after = screenToWorld(e.clientX, e.clientY);
      cam.x += after.x - before.x;
      cam.y += after.y - before.y;
    }, { passive: false });

    document.getElementById('wiki-graph-reset')?.addEventListener('click', () => {
      cam = { x: 0, y: 0, zoom: 1 };
      selectedNode = null;
    });

    document.getElementById('wiki-graph-labels')?.addEventListener('click', () => {
      showLabels = !showLabels;
    });

    resize();
    window.addEventListener('resize', resize);
    tick();
  }
});
</script>

