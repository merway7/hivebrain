---
import Layout from '../../layouts/Layout.astro';
import { getWiki, listPages, listSources, getPage, getSource, getPageRevisions, getLog, getWikiStats } from '../../lib/wikis';

const slug = Astro.params.slug;
if (!slug || !slug.includes('/')) {
  return Astro.redirect('/wikis');
}

const parts = slug.split('/');
const fullSlug = `${parts[0]}/${parts[1]}`;

const wiki = await getWiki(fullSlug);
if (!wiki) {
  return Astro.redirect('/wikis');
}

const pages = await listPages(wiki.id);
const sources = await listSources(wiki.id);
const stats = await getWikiStats(wiki.id);
const recentLog = await getLog(wiki.id, 20);

// Build category groups from page paths
interface CategoryGroup {
  name: string;
  pages: typeof pages;
  color: string;
  icon: string;
  description: string;
}

const CATEGORY_STYLES: Record<string, { color: string; icon: string; description: string }> = {
  identity:   { color: '#818cf8', icon: 'fingerprint', description: 'Who you are, documents, legal status' },
  finances:   { color: '#34d399', icon: 'wallet',      description: 'Money, accounts, budgets' },
  investing:  { color: '#fbbf24', icon: 'chart',       description: 'Portfolio, strategy, markets' },
  business:   { color: '#60a5fa', icon: 'briefcase',   description: 'Ventures, entities, plans' },
  personal:   { color: '#c084fc', icon: 'heart',       description: 'Health, goals, habits' },
  family:     { color: '#f472b6', icon: 'family',      description: 'Loved ones, plans, memories' },
  people:     { color: '#22d3ee', icon: 'people',      description: 'Contacts, relationships, network' },
  projects:   { color: '#fb923c', icon: 'rocket',      description: 'What you are building' },
  work:       { color: '#f87171', icon: 'building',    description: 'Career, employer, role' },
};

const DEFAULT_STYLE = { color: '#a1a1aa', icon: 'file', description: 'Uncategorized pages' };

const categoryMap = new Map<string, typeof pages>();
const rootPages: typeof pages = [];

for (const p of pages) {
  const pathParts = p.path.split('/');
  if (pathParts.length > 1) {
    const cat = pathParts[0];
    if (!categoryMap.has(cat)) categoryMap.set(cat, []);
    categoryMap.get(cat)!.push(p);
  } else {
    rootPages.push(p);
  }
}

const categories: CategoryGroup[] = [...categoryMap.entries()]
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([name, catPages]) => ({
    name,
    pages: catPages,
    ...(CATEGORY_STYLES[name] || DEFAULT_STYLE),
  }));

// Total wikilink count
const totalLinks = pages.reduce((sum, p) => sum + (p.wikilinks?.length || 0), 0);

// Build backlinks map
const backlinksMap = new Map<string, string[]>();
for (const p of pages) {
  for (const link of (p.wikilinks || [])) {
    const target = link.endsWith('.md') ? link : link + '.md';
    if (!backlinksMap.has(target)) backlinksMap.set(target, []);
    backlinksMap.get(target)!.push(p.path);
  }
}

// Recently updated pages (sorted by updated_at descending)
const recentPages = [...pages]
  .sort((a, b) => new Date(b.updated_at).getTime() - new Date(a.updated_at).getTime())
  .slice(0, 6);

// Most connected pages (by combined inbound + outbound links)
const mostConnected = [...pages]
  .map(p => ({
    ...p,
    connectionCount: (p.wikilinks?.length || 0) + (backlinksMap.get(p.path)?.length || 0),
  }))
  .sort((a, b) => b.connectionCount - a.connectionCount)
  .slice(0, 5);

// File viewing mode
const url = Astro.url;
const filePath = url.searchParams.get('file');
const fileLayer = url.searchParams.get('layer') || 'page';
const viewMode = url.searchParams.get('view') || 'dashboard';
let fileContent: any = null;
let fileRevisions: any[] = [];
let currentBacklinks: string[] = [];

if (filePath) {
  if (fileLayer === 'source') {
    fileContent = await getSource(wiki.id, filePath);
  } else {
    fileContent = await getPage(wiki.id, filePath);
    if (fileContent) {
      fileRevisions = await getPageRevisions(fileContent.id, 10);
      currentBacklinks = backlinksMap.get(filePath) || [];
    }
  }
}

// Get the page set for broken-link detection
const allPagePaths = new Set(pages.map(p => p.path));
const allPageNames = new Set(pages.map(p => p.path.replace(/\.md$/, '')));

// Greeting based on time of day
function getGreeting(): string {
  const hour = new Date().getHours();
  if (hour < 6) return 'Burning the midnight oil';
  if (hour < 12) return 'Good morning';
  if (hour < 17) return 'Good afternoon';
  if (hour < 21) return 'Good evening';
  return 'Late night session';
}

function timeAgo(dateStr: string): string {
  try {
    const d = new Date(dateStr);
    const diff = Date.now() - d.getTime();
    const mins = Math.floor(diff / 60000);
    if (mins < 1) return 'just now';
    if (mins < 60) return `${mins}m ago`;
    const hours = Math.floor(mins / 60);
    if (hours < 24) return `${hours}h ago`;
    const days = Math.floor(hours / 24);
    if (days < 7) return `${days}d ago`;
    if (days < 30) return `${Math.floor(days / 7)}w ago`;
    return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
  } catch { return dateStr; }
}

function escapeHtml(str: string): string {
  return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

/**
 * Renders markdown-ish content into styled HTML.
 * Handles: wikilinks, headings, bold, italic, lists, horizontal rules, code blocks.
 */
function renderContent(content: string): string {
  const escaped = escapeHtml(content);
  const lines = escaped.split('\n');
  let html = '';
  let inCodeBlock = false;
  let inList = false;
  let listType: 'ul' | 'ol' = 'ul';

  for (let i = 0; i < lines.length; i++) {
    let line = lines[i];

    // Code blocks
    if (line.startsWith('```')) {
      if (inCodeBlock) {
        html += '</code></pre>';
        inCodeBlock = false;
      } else {
        const lang = line.slice(3).trim();
        html += `<pre class="rendered-code"><code${lang ? ` data-lang="${lang}"` : ''}>`;
        inCodeBlock = true;
      }
      continue;
    }
    if (inCodeBlock) {
      html += line + '\n';
      continue;
    }

    // Close list if this line isn't a list item
    if (inList && !line.match(/^\s*[-*]\s/) && !line.match(/^\s*\d+\.\s/) && line.trim() !== '') {
      html += listType === 'ul' ? '</ul>' : '</ol>';
      inList = false;
    }

    // Horizontal rule
    if (line.match(/^---+$/)) {
      html += '<hr class="rendered-hr" />';
      continue;
    }

    // Headings
    const headingMatch = line.match(/^(#{1,4})\s+(.+)$/);
    if (headingMatch) {
      const level = headingMatch[1].length;
      const text = processInline(headingMatch[2]);
      html += `<h${level + 1} class="rendered-h${level}">${text}</h${level + 1}>`;
      continue;
    }

    // Unordered list items
    const ulMatch = line.match(/^\s*[-*]\s+(.+)$/);
    if (ulMatch) {
      if (!inList || listType !== 'ul') {
        if (inList) html += listType === 'ul' ? '</ul>' : '</ol>';
        html += '<ul class="rendered-list">';
        inList = true;
        listType = 'ul';
      }
      html += `<li>${processInline(ulMatch[1])}</li>`;
      continue;
    }

    // Ordered list items
    const olMatch = line.match(/^\s*\d+\.\s+(.+)$/);
    if (olMatch) {
      if (!inList || listType !== 'ol') {
        if (inList) html += listType === 'ul' ? '</ul>' : '</ol>';
        html += '<ol class="rendered-list">';
        inList = true;
        listType = 'ol';
      }
      html += `<li>${processInline(olMatch[1])}</li>`;
      continue;
    }

    // Empty line
    if (line.trim() === '') {
      if (inList) {
        html += listType === 'ul' ? '</ul>' : '</ol>';
        inList = false;
      }
      html += '<div class="rendered-spacer"></div>';
      continue;
    }

    // Regular paragraph
    html += `<p class="rendered-p">${processInline(line)}</p>`;
  }

  if (inCodeBlock) html += '</code></pre>';
  if (inList) html += listType === 'ul' ? '</ul>' : '</ol>';

  return html;
}

function processInline(text: string): string {
  // Wikilinks
  text = text.replace(/\[\[(.+?)\]\]/g, (match, inner) => {
    const [target, display] = inner.split('|');
    const label = (display || target).trim();
    const normalizedTarget = target.trim().endsWith('.md') ? target.trim() : target.trim() + '.md';
    const href = `/wikis/${fullSlug}?file=${encodeURIComponent(normalizedTarget)}`;
    const exists = allPagePaths.has(normalizedTarget) || allPageNames.has(target.trim());
    const cls = exists ? 'wikilink' : 'wikilink wikilink-broken';
    return `<a href="${escapeHtml(href)}" class="${cls}">${escapeHtml(label)}</a>`;
  });

  // Bold
  text = text.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
  // Italic
  text = text.replace(/\*(.+?)\*/g, '<em>$1</em>');
  // Inline code
  text = text.replace(/`(.+?)`/g, '<code class="rendered-inline-code">$1</code>');

  return text;
}

function getPageDisplayName(path: string): string {
  const name = path.split('/').pop() || path;
  return name.replace(/\.md$/, '').replace(/-/g, ' ');
}

function getCategoryFromPath(path: string): string {
  const parts = path.split('/');
  return parts.length > 1 ? parts[0] : '';
}

function getCategoryIcon(category: string): string {
  const icons: Record<string, string> = {
    identity: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>',
    finances: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M12 8v8"/><path d="M8 12h8"/></svg>',
    investing: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>',
    business: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/></svg>',
    personal: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>',
    family: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>',
    people: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>',
    projects: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="M12 15l-3-3"/><path d="M22 2L13.34 10.66"/><path d="M16.5 2.5a2.12 2.12 0 0 1 3 3l-7 7H9v-3.5l7-7z"/></svg>',
    work: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>',
  };
  return icons[category] || '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>';
}

// Extract first meaningful line from a page's content (for card summaries)
function getPageSummary(content: string, maxLen = 80): string {
  const lines = content.split('\n');
  for (const line of lines) {
    const trimmed = line.trim();
    if (trimmed && !trimmed.startsWith('#') && !trimmed.startsWith('---') && !trimmed.startsWith('```')) {
      return trimmed.length > maxLen ? trimmed.slice(0, maxLen) + '...' : trimmed;
    }
  }
  return '';
}

const pageTitle = fileContent
  ? `${getPageDisplayName(filePath!)} -- ${wiki.slug}`
  : `${wiki.slug} -- Your Brain`;

// Preload summaries for category cards (first page summary per category)
const categorySummaries = new Map<string, string>();
for (const cat of categories) {
  if (cat.pages.length > 0) {
    const firstPage = await getPage(wiki.id, cat.pages[0].path);
    if (firstPage) {
      categorySummaries.set(cat.name, getPageSummary(firstPage.content));
    }
  }
}
---

<Layout title={pageTitle}>
  <div class="wiki-shell">
    {/* Minimal top bar -- just branding + search on page view */}
    {fileContent ? (
      <nav class="page-topbar">
        <a href={`/wikis/${fullSlug}`} class="topbar-back" title="Back to dashboard">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/></svg>
          <span>Your Brain</span>
        </a>
        <div class="topbar-search-mini" id="topbar-search-mini">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
          <input type="text" placeholder="Search..." id="mini-search-input" autocomplete="off" />
          <kbd>/</kbd>
          <div class="mini-search-results" id="mini-search-results"></div>
        </div>
        <div class="topbar-spacer"></div>
      </nav>
    ) : viewMode === 'graph' ? (
      <nav class="page-topbar">
        <a href={`/wikis/${fullSlug}`} class="topbar-back" title="Back to dashboard">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/></svg>
          <span>Your Brain</span>
        </a>
        <div class="topbar-spacer"></div>
      </nav>
    ) : null}

    {viewMode === 'graph' && !filePath ? (
      <!-- ============================================= -->
      <!-- GRAPH VIEW                                    -->
      <!-- ============================================= -->
      <div class="wiki-graph" id="wiki-graph">
        <canvas id="wiki-graph-canvas"></canvas>
        <div class="graph-legend" id="wiki-graph-legend">
          <h4 class="legend-title">Categories</h4>
          {categories.map(cat => (
            <div class="legend-row">
              <span class="legend-dot" style={`background: ${cat.color}; box-shadow: 0 0 6px ${cat.color}88`}></span>
              <span class="legend-name">{cat.name}</span>
              <span class="legend-count">{cat.pages.length}</span>
            </div>
          ))}
        </div>
        <div class="graph-controls">
          <button class="graph-ctrl-btn" id="wiki-graph-reset">Reset</button>
          <button class="graph-ctrl-btn" id="wiki-graph-labels">Labels</button>
        </div>
        <div class="graph-info" id="wiki-graph-info"></div>
      </div>

    ) : fileContent ? (
      <!-- ============================================= -->
      <!-- PAGE VIEW (Document reader)                   -->
      <!-- ============================================= -->
      <article class="doc-reader">
        {/* Breadcrumb + meta */}
        <header class="doc-header">
          {getCategoryFromPath(filePath!) && (
            <div class="doc-category-label" style={`--cat-color: ${(CATEGORY_STYLES[getCategoryFromPath(filePath!)] || DEFAULT_STYLE).color}`}>
              <span class="doc-cat-icon" set:html={getCategoryIcon(getCategoryFromPath(filePath!))} />
              <span>{getCategoryFromPath(filePath!)}</span>
            </div>
          )}
          <h1 class="doc-title">{getPageDisplayName(filePath!)}</h1>
          <div class="doc-meta-row">
            {fileLayer === 'source' ? (
              <span class="doc-meta-pill source">Source file</span>
            ) : (
              <span class="doc-meta-pill">Revision {fileContent.revision}</span>
            )}
            <span class="doc-meta-pill subtle">Updated {timeAgo(fileContent.updated_at || fileContent.created_at)}</span>
            {fileContent.wikilinks?.length > 0 && (
              <span class="doc-meta-pill subtle">{fileContent.wikilinks.length} link{fileContent.wikilinks.length !== 1 ? 's' : ''}</span>
            )}
          </div>
        </header>

        {/* Content body */}
        <div class="doc-body">
          {fileLayer === 'source' ? (
            <pre class="doc-raw">{fileContent.content}</pre>
          ) : (
            <div class="doc-content" set:html={renderContent(fileContent.content)} />
          )}
        </div>

        {/* Outgoing links (wikilinks in this page) */}
        {fileContent.wikilinks?.length > 0 && fileLayer !== 'source' && (
          <div class="doc-links-section">
            <h3 class="doc-section-heading">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
              Links from this page
            </h3>
            <div class="doc-link-chips">
              {fileContent.wikilinks.map((link: string) => {
                const target = link.endsWith('.md') ? link : link + '.md';
                const exists = allPagePaths.has(target) || allPageNames.has(link);
                const cat = getCategoryFromPath(target);
                const catColor = (CATEGORY_STYLES[cat] || DEFAULT_STYLE).color;
                return (
                  <a
                    href={exists ? `/wikis/${fullSlug}?file=${encodeURIComponent(target)}` : '#'}
                    class:list={['doc-link-chip', { broken: !exists }]}
                    style={`--chip-color: ${catColor}`}
                  >
                    <span class="chip-dot" style={`background: ${catColor}`}></span>
                    {getPageDisplayName(target)}
                    {!exists && <span class="chip-missing">missing</span>}
                  </a>
                );
              })}
            </div>
          </div>
        )}

        {/* Backlinks */}
        {currentBacklinks.length > 0 && (
          <div class="doc-links-section">
            <h3 class="doc-section-heading">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 7h3a5 5 0 0 1 5 5 5 5 0 0 1-5 5h-3m-6 0H6a5 5 0 0 1-5-5 5 5 0 0 1 5-5h3"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
              Pages that link here
            </h3>
            <div class="doc-link-chips">
              {currentBacklinks.map(bl => {
                const cat = getCategoryFromPath(bl);
                const catColor = (CATEGORY_STYLES[cat] || DEFAULT_STYLE).color;
                return (
                  <a href={`/wikis/${fullSlug}?file=${encodeURIComponent(bl)}`} class="doc-link-chip" style={`--chip-color: ${catColor}`}>
                    <span class="chip-dot" style={`background: ${catColor}`}></span>
                    {getPageDisplayName(bl)}
                  </a>
                );
              })}
            </div>
          </div>
        )}

        {/* Revision history */}
        {fileRevisions.length > 1 && (
          <div class="doc-revisions">
            <h3 class="doc-section-heading">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              Version history
            </h3>
            <div class="revision-timeline">
              {fileRevisions.map((rev: any, i: number) => (
                <div class:list={['rev-row', { current: i === 0 }]}>
                  <div class="rev-marker">
                    <div class="rev-dot"></div>
                    {i < fileRevisions.length - 1 && <div class="rev-line"></div>}
                  </div>
                  <div class="rev-info">
                    <div class="rev-top">
                      <span class="rev-v">v{rev.revision}</span>
                      <span class="rev-msg">{rev.message || 'Updated'}</span>
                    </div>
                    <div class="rev-bottom">
                      <span>by {rev.pushed_by}</span>
                      <span>{timeAgo(rev.created_at)}</span>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}
      </article>

    ) : (
      <!-- ============================================= -->
      <!-- DASHBOARD VIEW (The brain home)               -->
      <!-- ============================================= -->
      <div class="brain-home">

        {/* Hero / Greeting */}
        <section class="hero">
          <div class="hero-text">
            <h1 class="hero-greeting">{getGreeting()}</h1>
            <p class="hero-summary">
              Your brain holds <strong>{stats.page_count} pages</strong> across <strong>{categories.length} areas</strong>,
              woven together by <strong>{totalLinks} connections</strong>.
            </p>
          </div>
          <div class="hero-actions">
            <a href={`/wikis/${fullSlug}?view=graph`} class="hero-graph-btn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="2"/><circle cx="6" cy="6" r="2"/><circle cx="18" cy="6" r="2"/><circle cx="6" cy="18" r="2"/><circle cx="18" cy="18" r="2"/><path d="M12 10V8"/><path d="M6.3 7.7l3.4 2.6"/><path d="M17.7 7.7l-3.4 2.6"/><path d="M6.3 16.3l3.4-2.6"/><path d="M17.7 16.3l-3.4-2.6"/></svg>
              <span>View graph</span>
            </a>
          </div>
        </section>

        {/* Spotlight search */}
        <section class="spotlight-wrap">
          <div class="spotlight" id="spotlight">
            <svg class="spotlight-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
            <input type="text" class="spotlight-input" placeholder="Search your brain..." id="spotlight-input" autocomplete="off" />
            <kbd class="spotlight-kbd">/</kbd>
            <div class="spotlight-results" id="spotlight-results"></div>
          </div>
        </section>

        {/* Quick access - Recently updated */}
        {recentPages.length > 0 && (
          <section class="quick-access">
            <h2 class="section-label">Recently updated</h2>
            <div class="quick-grid">
              {recentPages.map(p => {
                const cat = getCategoryFromPath(p.path);
                const catColor = (CATEGORY_STYLES[cat] || DEFAULT_STYLE).color;
                return (
                  <a href={`/wikis/${fullSlug}?file=${encodeURIComponent(p.path)}`} class="quick-card" style={`--cat-color: ${catColor}`}>
                    <span class="quick-cat" style={`color: ${catColor}`}>{cat || 'root'}</span>
                    <span class="quick-name">{getPageDisplayName(p.path)}</span>
                    <span class="quick-time">{timeAgo(p.updated_at)}</span>
                  </a>
                );
              })}
            </div>
          </section>
        )}

        {/* Category cards -- the main navigation */}
        <section class="categories-section">
          <h2 class="section-label">Your knowledge</h2>
          <div class="cat-grid">
            {categories.map(cat => {
              const summary = categorySummaries.get(cat.name) || '';
              return (
                <div class="cat-card" style={`--cat-color: ${cat.color}`}>
                  <div class="cat-card-head">
                    <div class="cat-icon-wrap" style={`background: ${cat.color}15; color: ${cat.color}`} set:html={getCategoryIcon(cat.name)} />
                    <div class="cat-title-group">
                      <h3 class="cat-name">{cat.name}</h3>
                      <span class="cat-desc">{cat.description}</span>
                    </div>
                    <span class="cat-badge">{cat.pages.length}</span>
                  </div>
                  {summary && <p class="cat-summary">{summary}</p>}
                  <div class="cat-pages">
                    {cat.pages.slice(0, 5).map(p => (
                      <a href={`/wikis/${fullSlug}?file=${encodeURIComponent(p.path)}`} class="cat-page-link">
                        <span class="cat-page-name">{getPageDisplayName(p.path)}</span>
                        <span class="cat-page-meta">{timeAgo(p.updated_at)}</span>
                      </a>
                    ))}
                    {cat.pages.length > 5 && (
                      <span class="cat-more">+{cat.pages.length - 5} more</span>
                    )}
                  </div>
                </div>
              );
            })}
          </div>
        </section>

        {/* Most connected pages */}
        {mostConnected.length > 0 && (
          <section class="connected-section">
            <h2 class="section-label">Most connected</h2>
            <div class="connected-list">
              {mostConnected.map(p => {
                const cat = getCategoryFromPath(p.path);
                const catColor = (CATEGORY_STYLES[cat] || DEFAULT_STYLE).color;
                const inbound = backlinksMap.get(p.path)?.length || 0;
                const outbound = p.wikilinks?.length || 0;
                return (
                  <a href={`/wikis/${fullSlug}?file=${encodeURIComponent(p.path)}`} class="connected-item" style={`--cat-color: ${catColor}`}>
                    <span class="connected-dot" style={`background: ${catColor}`}></span>
                    <span class="connected-name">{getPageDisplayName(p.path)}</span>
                    <span class="connected-stats">
                      <span title="Pages linking to this">{inbound} in</span>
                      <span title="Links from this page">{outbound} out</span>
                    </span>
                  </a>
                );
              })}
            </div>
          </section>
        )}

        {/* Recent activity */}
        {recentLog.length > 0 && (
          <section class="activity-section">
            <h2 class="section-label">Activity</h2>
            <div class="activity-list">
              {recentLog.slice(0, 8).map(entry => (
                <div class="activity-row">
                  <span class:list={['activity-op', `op-${entry.operation}`]}>{entry.operation}</span>
                  <span class="activity-summary">{entry.summary}</span>
                  <span class="activity-time">{timeAgo(entry.created_at)}</span>
                </div>
              ))}
            </div>
          </section>
        )}

        {/* Root-level pages */}
        {rootPages.length > 0 && (
          <section class="root-pages-section">
            <h2 class="section-label">Other pages</h2>
            <div class="root-page-list">
              {rootPages.map(p => (
                <a href={`/wikis/${fullSlug}?file=${encodeURIComponent(p.path)}`} class="root-page-link">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
                  {getPageDisplayName(p.path)}
                </a>
              ))}
            </div>
          </section>
        )}
      </div>
    )}
  </div>
</Layout>

<script define:vars={{ pages: pages.map(p => ({ path: p.path, wikilinks: p.wikilinks })), fullSlug, categories: categories.map(c => ({ name: c.name, color: c.color, pages: c.pages.map(p => ({ path: p.path, wikilinks: p.wikilinks })) })) }}>
document.addEventListener('DOMContentLoaded', () => {

  // ── Spotlight Search (Dashboard) ──
  function setupSearch(inputId, resultsId) {
    const input = document.getElementById(inputId);
    const results = document.getElementById(resultsId);
    if (!input || !results) return;

    let debounce;

    input.addEventListener('input', (e) => {
      clearTimeout(debounce);
      const query = e.target.value.trim().toLowerCase();

      if (query.length < 2) {
        results.classList.remove('visible');
        return;
      }

      debounce = setTimeout(() => {
        const matches = pages.filter(p => {
          const name = p.path.toLowerCase().replace(/[\/\-_\.]/g, ' ');
          return name.includes(query) || p.path.toLowerCase().includes(query);
        }).slice(0, 8);

        results.textContent = '';

        if (matches.length === 0) {
          const empty = document.createElement('div');
          empty.className = 'search-empty';
          empty.textContent = 'No pages found';
          results.appendChild(empty);
        } else {
          matches.forEach(p => {
            const displayName = p.path.split('/').pop().replace(/\.md$/, '').replace(/-/g, ' ');
            const cat = p.path.includes('/') ? p.path.split('/')[0] : '';

            const link = document.createElement('a');
            link.href = '/wikis/' + fullSlug + '?file=' + encodeURIComponent(p.path);
            link.className = 'search-result-item';

            if (cat) {
              const catSpan = document.createElement('span');
              catSpan.className = 'sr-cat';
              catSpan.textContent = cat;
              link.appendChild(catSpan);
            }

            const nameSpan = document.createElement('span');
            nameSpan.className = 'sr-name';
            nameSpan.textContent = displayName;
            link.appendChild(nameSpan);

            results.appendChild(link);
          });
        }
        results.classList.add('visible');
      }, 120);
    });

    input.addEventListener('blur', () => {
      setTimeout(() => results.classList.remove('visible'), 200);
    });

    input.addEventListener('focus', () => {
      if (input.value.trim().length >= 2) {
        results.classList.add('visible');
      }
    });
  }

  // Initialize both search bars
  setupSearch('spotlight-input', 'spotlight-results');
  setupSearch('mini-search-input', 'mini-search-results');

  // Keyboard shortcut: / to focus search
  document.addEventListener('keydown', (e) => {
    const anyInput = document.activeElement && (document.activeElement.tagName === 'INPUT' || document.activeElement.tagName === 'TEXTAREA');
    if (e.key === '/' && !anyInput) {
      e.preventDefault();
      const spotlight = document.getElementById('spotlight-input');
      const mini = document.getElementById('mini-search-input');
      if (spotlight) spotlight.focus();
      else if (mini) mini.focus();
    }
    if (e.key === 'Escape') {
      const spotlight = document.getElementById('spotlight-input');
      const mini = document.getElementById('mini-search-input');
      if (document.activeElement === spotlight || document.activeElement === mini) {
        document.activeElement.blur();
        document.getElementById('spotlight-results')?.classList.remove('visible');
        document.getElementById('mini-search-results')?.classList.remove('visible');
      }
    }
  });

  // ── Graph View ──
  const graphContainer = document.getElementById('wiki-graph');
  if (graphContainer) {
    const canvas = document.getElementById('wiki-graph-canvas');
    const ctx = canvas.getContext('2d');
    const infoEl = document.getElementById('wiki-graph-info');

    let W = 0, H = 0;
    let showLabels = true;
    let hoveredNode = null;
    let selectedNode = null;
    let dragNode = null;
    let isDragging = false;
    let isPanning = false;
    let panStart = { x: 0, y: 0, camX: 0, camY: 0 };
    let cam = { x: 0, y: 0, zoom: 1 };
    let animId;

    const catColorMap = {};
    categories.forEach(c => { catColorMap[c.name] = c.color; });

    const allPages = [];
    categories.forEach(c => c.pages.forEach(p => allPages.push(p)));

    const nodeMap = {};
    const spread = 300;

    const nodes = allPages.map((p, i) => {
      const cat = p.path.includes('/') ? p.path.split('/')[0] : '';
      const angle = (i / allPages.length) * Math.PI * 2;
      const linkCount = (p.wikilinks || []).length;
      const node = {
        id: p.path,
        label: p.path.split('/').pop().replace(/\.md$/, '').replace(/-/g, ' '),
        category: cat,
        color: catColorMap[cat] || '#a1a1aa',
        radius: Math.max(6, Math.min(16, 6 + linkCount * 1.5)),
        x: 500 + Math.cos(angle) * spread + (Math.random() - 0.5) * 100,
        y: 400 + Math.sin(angle) * spread + (Math.random() - 0.5) * 100,
        vx: 0, vy: 0,
        wikilinks: p.wikilinks || [],
      };
      nodeMap[p.path] = node;
      return node;
    });

    const edges = [];
    const edgeSet = new Set();
    for (const n of nodes) {
      for (const link of n.wikilinks) {
        const target = link.endsWith('.md') ? link : link + '.md';
        if (nodeMap[target]) {
          const key = [n.id, target].sort().join('::');
          if (!edgeSet.has(key)) {
            edgeSet.add(key);
            edges.push({ source: n.id, target: target });
          }
        }
      }
    }

    function resize() {
      W = graphContainer.clientWidth;
      H = graphContainer.clientHeight;
      canvas.width = W * devicePixelRatio;
      canvas.height = H * devicePixelRatio;
      canvas.style.width = W + 'px';
      canvas.style.height = H + 'px';
      ctx.setTransform(devicePixelRatio, 0, 0, devicePixelRatio, 0, 0);
    }

    function screenToWorld(sx, sy) {
      const rect = canvas.getBoundingClientRect();
      const cx = sx - rect.left, cy = sy - rect.top;
      return {
        x: (cx - W / 2) / cam.zoom + W / 2 - cam.x,
        y: (cy - H / 2) / cam.zoom + H / 2 - cam.y,
      };
    }

    const SPRING_LENGTH = 140, SPRING_STRENGTH = 0.005, REPULSION = 4000, DAMPING = 0.86, CENTER_GRAVITY = 0.0004;

    function simulate() {
      for (let i = 0; i < nodes.length; i++) {
        for (let j = i + 1; j < nodes.length; j++) {
          const a = nodes[i], b = nodes[j];
          const dx = b.x - a.x, dy = b.y - a.y;
          const dist = Math.sqrt(dx * dx + dy * dy) || 1;
          const force = REPULSION / (dist * dist);
          const fx = (dx / dist) * force, fy = (dy / dist) * force;
          a.vx -= fx; a.vy -= fy;
          b.vx += fx; b.vy += fy;
        }
      }

      for (const e of edges) {
        const a = nodeMap[e.source], b = nodeMap[e.target];
        if (!a || !b) continue;
        const dx = b.x - a.x, dy = b.y - a.y;
        const dist = Math.sqrt(dx * dx + dy * dy) || 1;
        const displacement = dist - SPRING_LENGTH;
        const force = displacement * SPRING_STRENGTH;
        const fx = (dx / dist) * force, fy = (dy / dist) * force;
        a.vx += fx; a.vy += fy;
        b.vx -= fx; b.vy -= fy;
      }

      const cx = W / 2, cy = H / 2;
      for (const n of nodes) {
        n.vx += (cx - n.x) * CENTER_GRAVITY;
        n.vy += (cy - n.y) * CENTER_GRAVITY;
      }

      for (const n of nodes) {
        if (n === dragNode) continue;
        n.vx *= DAMPING; n.vy *= DAMPING;
        n.x += n.vx; n.y += n.vy;
      }
    }

    function hexAlpha(hex, alpha) {
      const a = Math.round(alpha * 255).toString(16).padStart(2, '0');
      return hex + a;
    }

    function getConnected(nodeId) {
      const ids = {};
      for (const e of edges) {
        if (e.source === nodeId) ids[e.target] = true;
        if (e.target === nodeId) ids[e.source] = true;
      }
      return ids;
    }

    function draw() {
      ctx.clearRect(0, 0, W, H);
      const bg = ctx.createRadialGradient(W / 2, H / 2, 0, W / 2, H / 2, Math.max(W, H) * 0.6);
      bg.addColorStop(0, '#0e0e12');
      bg.addColorStop(1, '#08080b');
      ctx.fillStyle = bg;
      ctx.fillRect(0, 0, W, H);

      ctx.save();
      ctx.translate(W / 2, H / 2);
      ctx.scale(cam.zoom, cam.zoom);
      ctx.translate(-W / 2 + cam.x, -H / 2 + cam.y);

      const activeId = selectedNode ? selectedNode.id : (hoveredNode ? hoveredNode.id : null);
      const connectedIds = activeId ? getConnected(activeId) : null;

      for (const e of edges) {
        const a = nodeMap[e.source], b = nodeMap[e.target];
        if (!a || !b) continue;
        const isHighlighted = activeId && (e.source === activeId || e.target === activeId);
        const isDimmed = activeId && !isHighlighted;
        ctx.beginPath();
        ctx.moveTo(a.x, a.y);
        ctx.lineTo(b.x, b.y);
        if (isHighlighted) { ctx.strokeStyle = 'rgba(160,170,200,0.5)'; ctx.lineWidth = 2; }
        else if (isDimmed) { ctx.strokeStyle = 'rgba(60,60,80,0.08)'; ctx.lineWidth = 0.5; }
        else { ctx.strokeStyle = 'rgba(100,110,140,0.15)'; ctx.lineWidth = 1; }
        ctx.stroke();
      }

      for (const n of nodes) {
        const isActive = activeId === n.id;
        const isConnected = connectedIds && connectedIds[n.id];
        const isDimmed = activeId && !isActive && !isConnected;
        const r = n.radius;

        if (!isDimmed) {
          const glowSize = isActive ? r * 4 : (isConnected ? r * 3 : r * 2.2);
          const glowAlpha = isActive ? 0.3 : (isConnected ? 0.15 : 0.07);
          const grad = ctx.createRadialGradient(n.x, n.y, r * 0.3, n.x, n.y, glowSize);
          grad.addColorStop(0, hexAlpha(n.color, glowAlpha));
          grad.addColorStop(1, hexAlpha(n.color, 0));
          ctx.beginPath();
          ctx.arc(n.x, n.y, glowSize, 0, Math.PI * 2);
          ctx.fillStyle = grad;
          ctx.fill();
        }

        ctx.beginPath();
        ctx.arc(n.x, n.y, r, 0, Math.PI * 2);
        if (isDimmed) ctx.fillStyle = hexAlpha(n.color, 0.15);
        else if (isActive) ctx.fillStyle = hexAlpha(n.color, 0.9);
        else ctx.fillStyle = hexAlpha(n.color, 0.6);
        ctx.fill();

        if (!isDimmed) {
          ctx.strokeStyle = hexAlpha(n.color, isActive ? 0.9 : 0.3);
          ctx.lineWidth = isActive ? 2.5 : 1;
          ctx.stroke();
        }

        if (showLabels && !isDimmed) {
          ctx.font = '10px Inter, -apple-system, sans-serif';
          ctx.textAlign = 'center';
          ctx.fillStyle = isActive ? 'rgba(250,250,250,0.95)' : 'rgba(200,200,220,0.5)';
          const label = n.label.length > 20 ? n.label.slice(0, 18) + '..' : n.label;
          ctx.fillText(label, n.x, n.y + r + 14);
        }
      }
      ctx.restore();
    }

    function tick() {
      simulate();
      draw();
      infoEl.textContent = nodes.length + ' pages  |  ' + edges.length + ' connections';
      animId = requestAnimationFrame(tick);
    }

    function hitTest(mx, my) {
      const world = screenToWorld(mx, my);
      for (let i = nodes.length - 1; i >= 0; i--) {
        const n = nodes[i];
        const dx = world.x - n.x, dy = world.y - n.y;
        if (dx * dx + dy * dy < (n.radius + 4) * (n.radius + 4)) return n;
      }
      return null;
    }

    canvas.addEventListener('mousemove', (e) => {
      if (isPanning) {
        cam.x = panStart.camX + (e.clientX - panStart.x) / cam.zoom;
        cam.y = panStart.camY + (e.clientY - panStart.y) / cam.zoom;
        return;
      }
      if (dragNode) {
        isDragging = true;
        const world = screenToWorld(e.clientX, e.clientY);
        dragNode.x = world.x; dragNode.y = world.y;
        dragNode.vx = 0; dragNode.vy = 0;
        return;
      }
      hoveredNode = hitTest(e.clientX, e.clientY);
      canvas.style.cursor = hoveredNode ? 'pointer' : 'grab';
    });

    canvas.addEventListener('mousedown', (e) => {
      const hit = hitTest(e.clientX, e.clientY);
      if (hit) {
        dragNode = hit;
        isDragging = false;
        selectedNode = (selectedNode === hit) ? null : hit;
      } else {
        selectedNode = null;
        isPanning = true;
        panStart = { x: e.clientX, y: e.clientY, camX: cam.x, camY: cam.y };
        canvas.style.cursor = 'grabbing';
      }
    });

    canvas.addEventListener('mouseup', () => {
      if (dragNode && !isDragging) {
        window.location.href = '/wikis/' + fullSlug + '?file=' + encodeURIComponent(dragNode.id);
      }
      dragNode = null;
      isDragging = false;
      isPanning = false;
      canvas.style.cursor = hoveredNode ? 'pointer' : 'grab';
    });

    canvas.addEventListener('mouseleave', () => {
      hoveredNode = null; dragNode = null; isDragging = false; isPanning = false;
    });

    canvas.addEventListener('wheel', (e) => {
      e.preventDefault();
      const delta = e.deltaY > 0 ? 0.92 : 1.08;
      const newZoom = Math.max(0.3, Math.min(4, cam.zoom * delta));
      const before = screenToWorld(e.clientX, e.clientY);
      cam.zoom = newZoom;
      const after = screenToWorld(e.clientX, e.clientY);
      cam.x += after.x - before.x;
      cam.y += after.y - before.y;
    }, { passive: false });

    document.getElementById('wiki-graph-reset')?.addEventListener('click', () => {
      cam = { x: 0, y: 0, zoom: 1 };
      selectedNode = null;
    });

    document.getElementById('wiki-graph-labels')?.addEventListener('click', () => {
      showLabels = !showLabels;
    });

    resize();
    window.addEventListener('resize', resize);
    tick();
  }
});
</script>

<style>
  /* =============================================
     YOUR BRAIN -- Redesigned Personal Wiki
     Apple-inspired, warm, spacious
     ============================================= */

  /* -- Shell -- */
  .wiki-shell {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 24px 80px;
    min-height: 100vh;
  }


  /* ===========================================
     TOP BAR (Page view / Graph view only)
     =========================================== */
  .page-topbar {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 0;
    margin-bottom: 8px;
    border-bottom: 1px solid rgba(255,255,255,0.04);
  }

  .topbar-back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--text-muted);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    transition: color var(--transition);
    flex-shrink: 0;
  }

  .topbar-back:hover {
    color: var(--text-primary);
  }

  .topbar-spacer {
    flex: 1;
  }

  /* Mini search (page topbar) */
  .topbar-search-mini {
    position: relative;
    display: flex;
    align-items: center;
    max-width: 280px;
    flex: 1;
  }

  .topbar-search-mini svg {
    position: absolute;
    left: 10px;
    color: var(--text-dim);
    pointer-events: none;
  }

  .topbar-search-mini input {
    width: 100%;
    padding: 6px 36px 6px 34px;
    background: var(--bg-input);
    border: 1px solid var(--border);
    border-radius: 10px;
    color: var(--text-primary);
    font-size: 13px;
    font-family: var(--font-sans);
    outline: none;
    transition: all var(--transition);
  }

  .topbar-search-mini input::placeholder {
    color: var(--text-dim);
  }

  .topbar-search-mini input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-subtle);
  }

  .topbar-search-mini kbd {
    position: absolute;
    right: 8px;
    padding: 0 5px;
    background: var(--bg-overlay);
    border: 1px solid var(--border);
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--text-dim);
    pointer-events: none;
    line-height: 1.6;
  }

  .topbar-search-mini input:focus ~ kbd {
    display: none;
  }

  .mini-search-results {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    right: 0;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 10px;
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    z-index: 100;
    display: none;
  }

  .mini-search-results.visible {
    display: block;
  }


  /* ===========================================
     DASHBOARD -- HERO
     =========================================== */
  .brain-home {
    padding-top: 24px;
  }

  .hero {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 40px;
  }

  .hero-text {
    max-width: 600px;
  }

  .hero-greeting {
    font-size: 36px;
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.15;
    color: var(--text-primary);
    margin-bottom: 12px;
    background: linear-gradient(135deg, #fafafa 0%, #a1a1aa 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-summary {
    font-size: 16px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .hero-summary strong {
    color: var(--text-secondary);
    font-weight: 600;
  }

  .hero-actions {
    flex-shrink: 0;
  }

  .hero-graph-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 18px;
    background: var(--bg-input);
    border: 1px solid var(--border);
    border-radius: 10px;
    color: var(--text-muted);
    text-decoration: none;
    font-size: 13px;
    font-weight: 500;
    transition: all var(--transition);
  }

  .hero-graph-btn:hover {
    background: var(--bg-hover);
    border-color: var(--border-hover);
    color: var(--text-primary);
  }


  /* ===========================================
     SPOTLIGHT SEARCH
     =========================================== */
  .spotlight-wrap {
    margin-bottom: 48px;
  }

  .spotlight {
    position: relative;
    max-width: 560px;
    margin: 0 auto;
  }

  .spotlight-icon {
    position: absolute;
    left: 16px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-dim);
    pointer-events: none;
  }

  .spotlight-input {
    width: 100%;
    padding: 14px 48px 14px 48px;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 14px;
    color: var(--text-primary);
    font-size: 16px;
    font-family: var(--font-sans);
    outline: none;
    transition: all 200ms ease;
  }

  .spotlight-input::placeholder {
    color: var(--text-dim);
  }

  .spotlight-input:focus {
    border-color: var(--accent);
    background: var(--bg-card);
    box-shadow: 0 0 0 4px var(--accent-subtle), 0 8px 32px rgba(0,0,0,0.2);
  }

  .spotlight-kbd {
    position: absolute;
    right: 14px;
    top: 50%;
    transform: translateY(-50%);
    padding: 2px 8px;
    background: var(--bg-overlay);
    border: 1px solid var(--border);
    border-radius: 6px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-dim);
    pointer-events: none;
  }

  .spotlight-input:focus ~ .spotlight-kbd {
    display: none;
  }

  .spotlight-results {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    right: 0;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 14px;
    box-shadow: 0 16px 48px rgba(0,0,0,0.4);
    overflow: hidden;
    z-index: 100;
    display: none;
  }

  .spotlight-results.visible {
    display: block;
  }

  /* Search results (shared) */
  .search-empty {
    padding: 20px;
    text-align: center;
    color: var(--text-dim);
    font-size: 14px;
  }

  :global(.search-result-item) {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 16px;
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 14px;
    transition: background var(--transition);
    border-bottom: 1px solid rgba(255,255,255,0.03);
  }

  :global(.search-result-item:last-child) {
    border-bottom: none;
  }

  :global(.search-result-item:hover) {
    background: var(--bg-hover);
    color: var(--text-primary);
  }

  :global(.sr-cat) {
    font-size: 11px;
    color: var(--text-dim);
    text-transform: capitalize;
    letter-spacing: 0.02em;
    flex-shrink: 0;
    background: var(--bg-input);
    padding: 2px 8px;
    border-radius: 6px;
  }

  :global(.sr-name) {
    text-transform: capitalize;
    font-weight: 500;
  }


  /* ===========================================
     SECTION LABELS
     =========================================== */
  .section-label {
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-dim);
    margin-bottom: 16px;
  }


  /* ===========================================
     QUICK ACCESS (Recently updated)
     =========================================== */
  .quick-access {
    margin-bottom: 48px;
  }

  .quick-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }

  .quick-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 14px 16px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    text-decoration: none;
    transition: all 200ms ease;
    position: relative;
    overflow: hidden;
  }

  .quick-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--cat-color);
    opacity: 0.5;
    transition: opacity 200ms ease;
  }

  .quick-card:hover {
    border-color: var(--border-hover);
    background: var(--bg-card-hover);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.15);
  }

  .quick-card:hover::before {
    opacity: 1;
  }

  .quick-cat {
    font-size: 11px;
    font-weight: 600;
    text-transform: capitalize;
    letter-spacing: 0.02em;
  }

  .quick-name {
    font-size: 15px;
    font-weight: 600;
    color: var(--text-primary);
    text-transform: capitalize;
    line-height: 1.3;
  }

  .quick-time {
    font-size: 12px;
    color: var(--text-dim);
  }


  /* ===========================================
     CATEGORY CARDS
     =========================================== */
  .categories-section {
    margin-bottom: 48px;
  }

  .cat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 16px;
  }

  .cat-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 20px;
    transition: all 250ms ease;
    position: relative;
    overflow: hidden;
  }

  /* Subtle gradient glow at top */
  .cat-card::before {
    content: '';
    position: absolute;
    top: -1px;
    left: -1px;
    right: -1px;
    height: 80px;
    background: linear-gradient(180deg, color-mix(in srgb, var(--cat-color) 6%, transparent) 0%, transparent 100%);
    border-radius: 14px 14px 0 0;
    pointer-events: none;
  }

  .cat-card:hover {
    border-color: color-mix(in srgb, var(--cat-color) 30%, var(--border));
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(0,0,0,0.15), 0 0 0 1px color-mix(in srgb, var(--cat-color) 10%, transparent);
  }

  .cat-card-head {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 10px;
    position: relative;
  }

  .cat-icon-wrap {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .cat-icon-wrap :global(svg) {
    width: 18px;
    height: 18px;
  }

  .cat-title-group {
    flex: 1;
    min-width: 0;
  }

  .cat-name {
    font-size: 16px;
    font-weight: 600;
    color: var(--text-primary);
    text-transform: capitalize;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .cat-desc {
    font-size: 12px;
    color: var(--text-dim);
    line-height: 1.3;
  }

  .cat-badge {
    font-size: 12px;
    font-weight: 600;
    color: var(--text-dim);
    background: var(--bg-input);
    padding: 2px 9px;
    border-radius: 99px;
    flex-shrink: 0;
  }

  .cat-summary {
    font-size: 13px;
    color: var(--text-muted);
    line-height: 1.5;
    margin-bottom: 14px;
    position: relative;
    padding-left: 10px;
    border-left: 2px solid color-mix(in srgb, var(--cat-color) 30%, transparent);
  }

  .cat-pages {
    display: flex;
    flex-direction: column;
    gap: 1px;
    position: relative;
  }

  .cat-page-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 7px 10px;
    border-radius: 8px;
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 14px;
    transition: all var(--transition);
  }

  .cat-page-link:hover {
    background: var(--bg-hover);
    color: var(--text-primary);
  }

  .cat-page-name {
    text-transform: capitalize;
    font-weight: 500;
  }

  .cat-page-meta {
    font-size: 11px;
    color: var(--text-dim);
    flex-shrink: 0;
  }

  .cat-more {
    display: block;
    padding: 6px 10px;
    font-size: 12px;
    color: var(--text-dim);
    font-style: italic;
  }


  /* ===========================================
     MOST CONNECTED
     =========================================== */
  .connected-section {
    margin-bottom: 48px;
  }

  .connected-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
  }

  .connected-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 14px;
    transition: all var(--transition);
    border-bottom: 1px solid rgba(255,255,255,0.03);
  }

  .connected-item:last-child {
    border-bottom: none;
  }

  .connected-item:hover {
    background: var(--bg-hover);
    color: var(--text-primary);
  }

  .connected-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .connected-name {
    flex: 1;
    font-weight: 500;
    text-transform: capitalize;
  }

  .connected-stats {
    display: flex;
    gap: 12px;
    font-size: 12px;
    color: var(--text-dim);
    flex-shrink: 0;
  }


  /* ===========================================
     ACTIVITY
     =========================================== */
  .activity-section {
    margin-bottom: 48px;
  }

  .activity-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
  }

  .activity-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 16px;
    border-bottom: 1px solid rgba(255,255,255,0.03);
  }

  .activity-row:last-child {
    border-bottom: none;
  }

  .activity-op {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    flex-shrink: 0;
    padding: 2px 8px;
    border-radius: 6px;
    min-width: 60px;
    text-align: center;
  }

  .activity-op.op-ingest {
    color: var(--green);
    background: var(--green-bg);
  }

  .activity-op.op-lint {
    color: var(--amber);
    background: var(--amber-bg);
  }

  .activity-op.op-query {
    color: var(--blue);
    background: var(--blue-bg);
  }

  .activity-summary {
    flex: 1;
    font-size: 13px;
    color: var(--text-secondary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .activity-time {
    font-size: 12px;
    color: var(--text-dim);
    flex-shrink: 0;
  }


  /* ===========================================
     ROOT PAGES
     =========================================== */
  .root-pages-section {
    margin-bottom: 48px;
  }

  .root-page-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .root-page-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 10px;
    color: var(--text-muted);
    text-decoration: none;
    font-size: 13px;
    font-weight: 500;
    text-transform: capitalize;
    transition: all var(--transition);
  }

  .root-page-link:hover {
    background: var(--bg-hover);
    border-color: var(--border-hover);
    color: var(--text-primary);
  }

  .root-page-link svg {
    opacity: 0.5;
  }


  /* ===========================================
     DOCUMENT READER (Page View)
     =========================================== */
  .doc-reader {
    max-width: 720px;
    margin: 0 auto;
    padding: 20px 0 80px;
  }

  .doc-header {
    margin-bottom: 36px;
    padding-bottom: 24px;
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }

  .doc-category-label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 600;
    color: var(--cat-color);
    text-transform: capitalize;
    margin-bottom: 8px;
    letter-spacing: 0.01em;
  }

  .doc-cat-icon :global(svg) {
    width: 14px;
    height: 14px;
  }

  .doc-title {
    font-size: 32px;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.03em;
    line-height: 1.15;
    text-transform: capitalize;
    margin-bottom: 12px;
  }

  .doc-meta-row {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .doc-meta-pill {
    font-size: 12px;
    font-weight: 500;
    color: var(--text-muted);
    padding: 3px 10px;
    background: var(--bg-input);
    border: 1px solid var(--border);
    border-radius: 8px;
  }

  .doc-meta-pill.source {
    background: var(--amber-bg);
    border-color: transparent;
    color: var(--amber);
  }

  .doc-meta-pill.subtle {
    border-color: transparent;
    background: transparent;
    color: var(--text-dim);
    padding-left: 0;
  }


  /* ===========================================
     DOCUMENT CONTENT (Rendered markdown)
     =========================================== */
  .doc-body {
    margin-bottom: 40px;
  }

  .doc-content {
    font-size: 15px;
    line-height: 1.8;
    color: var(--text-secondary);
    font-family: var(--font-sans);
  }

  .doc-content :global(.rendered-h1) {
    font-size: 24px;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.02em;
    margin: 32px 0 16px;
    line-height: 1.3;
  }

  .doc-content :global(.rendered-h2) {
    font-size: 20px;
    font-weight: 600;
    color: var(--text-primary);
    letter-spacing: -0.015em;
    margin: 28px 0 12px;
    line-height: 1.3;
  }

  .doc-content :global(.rendered-h3) {
    font-size: 16px;
    font-weight: 600;
    color: var(--text-primary);
    margin: 24px 0 10px;
    line-height: 1.4;
  }

  .doc-content :global(.rendered-h4) {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 20px 0 8px;
  }

  .doc-content :global(.rendered-p) {
    margin-bottom: 8px;
  }

  .doc-content :global(.rendered-spacer) {
    height: 12px;
  }

  .doc-content :global(.rendered-hr) {
    border: none;
    border-top: 1px solid rgba(255,255,255,0.06);
    margin: 28px 0;
  }

  .doc-content :global(.rendered-list) {
    margin: 8px 0 8px 20px;
    padding: 0;
  }

  .doc-content :global(.rendered-list li) {
    margin-bottom: 4px;
    padding-left: 4px;
  }

  .doc-content :global(.rendered-code) {
    display: block;
    background: var(--bg-input);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 16px 20px;
    margin: 16px 0;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .doc-content :global(.rendered-inline-code) {
    background: var(--bg-input);
    padding: 2px 6px;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--accent);
  }

  .doc-content :global(strong) {
    color: var(--text-primary);
    font-weight: 600;
  }

  .doc-content :global(em) {
    color: var(--text-secondary);
    font-style: italic;
  }

  .doc-raw {
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.6;
    color: var(--text-secondary);
    background: var(--bg-input);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 20px;
    overflow-x: auto;
    white-space: pre-wrap;
    word-wrap: break-word;
  }


  /* -- Wikilinks -- */
  :global(.wikilink) {
    color: var(--accent);
    text-decoration: none;
    padding: 2px 8px;
    margin: 0 1px;
    background: var(--accent-subtle);
    border-radius: 6px;
    transition: all var(--transition);
    font-weight: 500;
  }

  :global(.wikilink:hover) {
    background: rgba(129,140,248,0.2);
    color: #c7d2fe;
  }

  :global(.wikilink-broken) {
    color: var(--amber);
    background: var(--amber-bg);
  }

  :global(.wikilink-broken:hover) {
    background: rgba(251,191,36,0.15);
    color: #fcd34d;
  }


  /* ===========================================
     DOCUMENT LINKS / BACKLINKS
     =========================================== */
  .doc-links-section {
    padding: 24px 0;
    border-top: 1px solid rgba(255,255,255,0.06);
  }

  .doc-section-heading {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-secondary);
    margin-bottom: 14px;
  }

  .doc-section-heading svg {
    color: var(--text-dim);
  }

  .doc-link-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .doc-link-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 14px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 10px;
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 13px;
    font-weight: 500;
    text-transform: capitalize;
    transition: all var(--transition);
  }

  .doc-link-chip:hover {
    background: var(--bg-hover);
    border-color: var(--border-hover);
    color: var(--text-primary);
  }

  .doc-link-chip.broken {
    opacity: 0.6;
    border-style: dashed;
  }

  .chip-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .chip-missing {
    font-size: 10px;
    color: var(--amber);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }


  /* ===========================================
     DOCUMENT REVISIONS
     =========================================== */
  .doc-revisions {
    padding: 24px 0;
    border-top: 1px solid rgba(255,255,255,0.06);
  }

  .revision-timeline {
    display: flex;
    flex-direction: column;
  }

  .rev-row {
    display: flex;
    gap: 14px;
    min-height: 48px;
  }

  .rev-marker {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 12px;
    flex-shrink: 0;
    padding-top: 4px;
  }

  .rev-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--border-hover);
    flex-shrink: 0;
  }

  .rev-row.current .rev-dot {
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent-glow);
  }

  .rev-line {
    width: 1px;
    flex: 1;
    background: var(--border);
    margin: 4px 0;
  }

  .rev-info {
    flex: 1;
    padding-bottom: 16px;
    min-width: 0;
  }

  .rev-top {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 2px;
  }

  .rev-v {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    color: var(--accent);
    flex-shrink: 0;
  }

  .rev-msg {
    font-size: 13px;
    color: var(--text-secondary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .rev-bottom {
    display: flex;
    gap: 12px;
    font-size: 12px;
    color: var(--text-dim);
  }


  /* ===========================================
     GRAPH VIEW
     =========================================== */
  .wiki-graph {
    position: relative;
    width: 100%;
    height: calc(100vh - 100px);
    background: #08080b;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid var(--border);
  }

  #wiki-graph-canvas {
    display: block;
    cursor: grab;
    width: 100%;
    height: 100%;
  }

  #wiki-graph-canvas:active {
    cursor: grabbing;
  }

  .graph-legend {
    position: absolute;
    bottom: 16px;
    left: 16px;
    background: rgba(10, 10, 14, 0.88);
    border: 1px solid rgba(100, 110, 140, 0.2);
    border-radius: 12px;
    padding: 14px 18px;
    backdrop-filter: blur(12px);
    z-index: 10;
  }

  .legend-title {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-dim);
    margin-bottom: 10px;
  }

  .legend-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 5px;
    font-size: 13px;
  }

  .legend-row:last-child {
    margin-bottom: 0;
  }

  .legend-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .legend-name {
    color: var(--text-muted);
    text-transform: capitalize;
    flex: 1;
  }

  .legend-count {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-dim);
  }

  .graph-controls {
    position: absolute;
    top: 16px;
    right: 16px;
    display: flex;
    gap: 6px;
    z-index: 10;
  }

  .graph-ctrl-btn {
    background: rgba(10, 10, 14, 0.88);
    border: 1px solid rgba(100, 110, 140, 0.2);
    border-radius: 8px;
    color: var(--text-muted);
    padding: 6px 14px;
    font-size: 12px;
    font-family: var(--font-sans);
    font-weight: 500;
    cursor: pointer;
    backdrop-filter: blur(12px);
    transition: all var(--transition);
  }

  .graph-ctrl-btn:hover {
    border-color: rgba(100, 110, 140, 0.4);
    color: var(--text-primary);
  }

  .graph-info {
    position: absolute;
    bottom: 16px;
    right: 16px;
    font-size: 12px;
    color: var(--text-dim);
