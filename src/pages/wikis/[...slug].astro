  .wiki-main-col {
    min-width: 0;
  }


  /* ===========================================
     TABLE OF CONTENTS CARD (main page)
     =========================================== */
  .wiki-toc-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 16px 20px;
    margin-bottom: 24px;
  }

  .toc-card-title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-dim);
    margin-bottom: 12px;
  }

  .toc-card-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .toc-card-link {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 8px;
    border-radius: 6px;
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 14px;
    transition: all var(--transition);
  }

  .toc-card-link:hover {
    background: var(--bg-hover);
    color: var(--text-primary);
  }

  .toc-num {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-dim);
    width: 20px;
    flex-shrink: 0;
  }

  .toc-text {
    flex: 1;
    font-weight: 500;
  }

  .toc-count {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-dim);
    background: var(--bg-input);
    padding: 1px 6px;
    border-radius: 4px;
  }


  /* ===========================================
     WIKI SECTIONS (main page)
     =========================================== */
  .wiki-section {
    margin-bottom: 8px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
  }

  .wiki-section-header {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 20px;
    border-bottom: 1px solid var(--border);
    position: relative;
  }

  .wiki-section-header::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--section-color);
  }

  .section-icon-wrap {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .section-icon-wrap :global(svg) {
    width: 18px;
    height: 18px;
  }

  .section-title-group {
    flex: 1;
    min-width: 0;
  }

  .wiki-section-title {
    font-size: 17px;
    font-weight: 600;
    color: var(--text-primary);
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .wiki-section-desc {
    font-size: 12px;
    color: var(--text-dim);
    line-height: 1.3;
    margin-top: 2px;
  }

  .section-page-count {
    font-size: 12px;
    color: var(--text-dim);
    background: var(--bg-input);
    padding: 3px 10px;
    border-radius: 99px;
    flex-shrink: 0;
    font-weight: 500;
  }

  .wiki-section-summary {
    font-size: 13px;
    color: var(--text-muted);
    padding: 12px 20px;
    border-bottom: 1px solid rgba(255,255,255,0.03);
    line-height: 1.5;
  }

  .wiki-section-pages {
    display: flex;
    flex-direction: column;
  }

  .wiki-page-row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 20px;
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 14px;
    transition: all var(--transition);
    border-bottom: 1px solid rgba(255,255,255,0.03);
  }

  .wiki-page-row:last-child {
    border-bottom: none;
  }

  .wiki-page-row:hover {
    background: var(--bg-hover);
    color: var(--text-primary);
  }

  .page-row-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .page-row-name {
    flex: 1;
    font-weight: 500;
    text-transform: capitalize;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .page-row-links {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    font-size: 11px;
    color: var(--text-dim);
    flex-shrink: 0;
  }

  .page-row-links svg {
    opacity: 0.5;
  }

  .page-row-time {
    font-size: 12px;
    color: var(--text-dim);
    flex-shrink: 0;
  }

  .page-row-arrow {
    color: var(--text-dim);
    opacity: 0;
    transition: opacity var(--transition);
    flex-shrink: 0;
  }

  .wiki-page-row:hover .page-row-arrow {
    opacity: 1;
  }


  /* ===========================================
     SIDEBAR (right column on main page)
     =========================================== */
  .wiki-sidebar {
    position: sticky;
    top: 72px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  /* Infobox */
  .wiki-infobox {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 24px 20px;
    text-align: center;
  }

  .infobox-photo {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: var(--bg-input);
    border: 2px solid var(--border);
    margin: 0 auto 12px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .infobox-name {
    font-size: 18px;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 2px;
    text-transform: capitalize;
  }

  .infobox-subtitle {
    font-size: 12px;
    color: var(--text-dim);
    margin-bottom: 16px;
  }

  .infobox-stats {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin-bottom: 16px;
  }

  .infobox-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
  }

  .infobox-stat-num {
    font-size: 20px;
    font-weight: 700;
    color: var(--text-primary);
    font-family: var(--font-mono);
  }

  .infobox-stat-label {
    font-size: 11px;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .infobox-divider {
    height: 1px;
    background: var(--border);
    margin-bottom: 14px;
  }

  .infobox-facts {
    display: flex;
    flex-direction: column;
    gap: 6px;
    text-align: left;
  }

  .infobox-fact-row {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
  }

  .infobox-fact-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .infobox-fact-key {
    flex: 1;
    color: var(--text-secondary);
    text-transform: capitalize;
    font-weight: 500;
  }

  .infobox-fact-value {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-dim);
  }

  /* Sidebar cards */
  .sidebar-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 16px;
  }

  .sidebar-card-title {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-dim);
    margin-bottom: 10px;
  }

  .sidebar-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .sidebar-link {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 5px 6px;
    border-radius: 6px;
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 13px;
    transition: all var(--transition);
  }

  .sidebar-link:hover {
    background: var(--bg-hover);
    color: var(--text-primary);
  }

  .sidebar-link-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .sidebar-link-name {
    flex: 1;
    text-transform: capitalize;
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0;
  }

  .sidebar-link-count {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-dim);
  }

  .sidebar-link-time {
    font-size: 11px;
    color: var(--text-dim);
    flex-shrink: 0;
  }

  /* Sidebar activity */
  .sidebar-activity {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .sidebar-activity-row {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 12px;
  }

  .sidebar-op {
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    padding: 1px 6px;
    border-radius: 4px;
    flex-shrink: 0;
  }

  .sidebar-op.op-ingest {
    color: var(--green);
    background: var(--green-bg);
  }

  .sidebar-op.op-lint {
    color: var(--amber);
    background: var(--amber-bg);
  }

  .sidebar-op.op-query {
    color: var(--blue);
    background: var(--blue-bg);
  }

  .sidebar-activity-text {
    color: var(--text-muted);
    line-height: 1.4;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }


  /* ===========================================
     PAGE VIEW LAYOUT
     =========================================== */
  .page-layout {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 32px;
    max-width: 1000px;
    margin: 0 auto;
  }

  .page-article {
    min-width: 0;
    padding-bottom: 80px;
  }

  /* TOC Sidebar (desktop) */
  .page-toc-sidebar {
    position: relative;
  }

  .page-toc-sticky {
    position: sticky;
    top: 72px;
  }

  .toc-label {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-dim);
    margin-bottom: 10px;
    padding-left: 12px;
  }

  .toc-nav {
    display: flex;
    flex-direction: column;
    gap: 1px;
    border-left: 1px solid var(--border);
    padding-left: 0;
  }

  .toc-link {
    display: block;
    padding: 4px 12px;
    font-size: 12px;
    color: var(--text-dim);
    text-decoration: none;
    transition: all var(--transition);
    border-left: 2px solid transparent;
    margin-left: -1px;
    line-height: 1.4;
  }

  .toc-link:hover {
    color: var(--text-secondary);
  }

  .toc-link.active {
    color: var(--accent);
    border-left-color: var(--accent);
  }

  .toc-level-2 {
    padding-left: 20px;
    font-size: 11px;
  }

  .toc-level-3 {
    padding-left: 28px;
    font-size: 11px;
  }

  /* Mobile TOC */
  .page-toc-mobile {
    display: none;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 8px;
    margin-bottom: 20px;
    overflow: hidden;
  }

  .toc-mobile-toggle {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    font-size: 13px;
    font-weight: 500;
    color: var(--text-secondary);
    cursor: pointer;
    list-style: none;
  }

  .toc-mobile-toggle::-webkit-details-marker {
    display: none;
  }

  .toc-chevron {
    margin-left: auto;
    transition: transform 200ms ease;
  }

  details[open] .toc-chevron {
    transform: rotate(180deg);
  }

  .toc-mobile-nav {
    display: flex;
    flex-direction: column;
    padding: 0 14px 12px;
    gap: 2px;
  }


  /* ===========================================
     PAGE HEADER
     =========================================== */
  .page-header {
    margin-bottom: 24px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--border);
  }

  .page-cat-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 600;
    color: var(--cat-color);
    text-transform: capitalize;
    text-decoration: none;
    margin-bottom: 8px;
    padding: 3px 10px;
    background: rgba(129, 140, 248, 0.08);
    border-radius: 6px;
    transition: all var(--transition);
  }

  .page-cat-badge:hover {
    background: rgba(129, 140, 248, 0.15);
  }

  .page-cat-icon :global(svg) {
    width: 14px;
    height: 14px;
  }

  .page-title {
    font-size: 32px;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.03em;
    line-height: 1.15;
    text-transform: capitalize;
    margin-bottom: 10px;
  }

  .page-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .page-meta-tag {
    font-size: 12px;
    font-weight: 500;
    color: var(--text-muted);
    padding: 2px 8px;
    background: var(--bg-input);
    border: 1px solid var(--border);
    border-radius: 6px;
    font-family: var(--font-mono);
  }

  .page-meta-tag.source {
    background: var(--amber-bg);
    border-color: transparent;
    color: var(--amber);
  }

  .page-meta-text {
    font-size: 13px;
    color: var(--text-dim);
  }


  /* ===========================================
     QUICK FACTS CARD (page view)
     =========================================== */
  .quick-facts-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 10px;
    margin-bottom: 24px;
    overflow: hidden;
  }

  .quick-facts-header {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    background: var(--bg-input);
    border-bottom: 1px solid var(--border);
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-dim);
  }

  .quick-facts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 0;
  }

  .quick-fact-row {
    display: flex;
    align-items: baseline;
    gap: 8px;
    padding: 8px 16px;
    border-bottom: 1px solid rgba(255,255,255,0.03);
    border-right: 1px solid rgba(255,255,255,0.03);
  }

  .quick-fact-row:last-child {
    border-bottom: none;
  }

  .quick-fact-key {
    font-size: 12px;
    font-weight: 600;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    flex-shrink: 0;
    min-width: 80px;
  }

  .quick-fact-value {
    font-size: 13px;
    color: var(--text-secondary);
    font-weight: 500;
  }

  .quick-fact-value.status-green {
    color: var(--green);
  }

  .quick-fact-value.status-amber {
    color: var(--amber);
  }

  .quick-fact-value.status-red {
    color: var(--red);
  }

  .quick-fact-value :global(.wikilink) {
    font-size: 12px;
    padding: 1px 6px;
  }


  /* ===========================================
     PAGE CONTENT (Enhanced markdown rendering)
     =========================================== */
  .page-body {
    margin-bottom: 32px;
  }

  .page-content {
    font-size: 15px;
    line-height: 1.75;
    color: var(--text-secondary);
    font-family: var(--font-sans);
  }

  /* Headings with anchor links */
  .page-content :global(.wiki-heading) {
    position: relative;
    scroll-margin-top: 72px;
  }

  .page-content :global(.wiki-heading-anchor) {
    position: absolute;
    left: -20px;
    color: var(--text-dim);
    text-decoration: none;
    opacity: 0;
    transition: opacity var(--transition);
    font-weight: 400;
  }

  .page-content :global(.wiki-heading:hover .wiki-heading-anchor) {
    opacity: 1;
  }

  .page-content :global(.wiki-h1) {
    font-size: 24px;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.02em;
    margin: 40px 0 16px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border);
    line-height: 1.3;
  }

  .page-content :global(.wiki-h2) {
    font-size: 20px;
    font-weight: 600;
    color: var(--text-primary);
    letter-spacing: -0.015em;
    margin: 32px 0 12px;
    line-height: 1.3;
  }

  .page-content :global(.wiki-h3) {
    font-size: 16px;
    font-weight: 600;
    color: var(--text-primary);
    margin: 24px 0 10px;
    line-height: 1.4;
  }

  .page-content :global(.wiki-h4) {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 20px 0 8px;
  }

  .page-content :global(.wiki-p) {
    margin-bottom: 8px;
  }

  .page-content :global(.wiki-spacer) {
    height: 12px;
  }

  .page-content :global(.wiki-hr) {
    border: none;
    border-top: 1px solid var(--border);
    margin: 28px 0;
  }

  /* Lists */
  .page-content :global(.wiki-list) {
    margin: 8px 0 8px 20px;
    padding: 0;
  }

  .page-content :global(.wiki-list li) {
    margin-bottom: 4px;
    padding-left: 4px;
    line-height: 1.6;
  }

  .page-content :global(.wiki-list li::marker) {
    color: var(--text-dim);
  }

  /* Tables */
  .page-content :global(.wiki-table-wrap) {
    margin: 16px 0;
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: 8px;
  }

  .page-content :global(.wiki-table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }

  .page-content :global(.wiki-table th) {
    background: var(--bg-input);
    padding: 8px 14px;
    text-align: left;
    font-weight: 600;
    color: var(--text-primary);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    border-bottom: 1px solid var(--border);
  }

  .page-content :global(.wiki-table td) {
    padding: 8px 14px;
    border-bottom: 1px solid rgba(255,255,255,0.03);
    color: var(--text-secondary);
  }

  .page-content :global(.wiki-table tr:last-child td) {
    border-bottom: none;
  }

  .page-content :global(.wiki-table tr:hover td) {
    background: var(--bg-hover);
  }

  /* Key-Value grid */
  .page-content :global(.wiki-kv-grid) {
    display: grid;
    grid-template-columns: 1fr;
    margin: 12px 0;
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
  }

  .page-content :global(.wiki-kv-item) {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 8px 14px;
    border-bottom: 1px solid rgba(255,255,255,0.03);
  }

  .page-content :global(.wiki-kv-item:last-child) {
    border-bottom: none;
  }

  .page-content :global(.wiki-kv-key) {
    font-size: 12px;
    font-weight: 600;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    min-width: 120px;
    flex-shrink: 0;
  }

  .page-content :global(.wiki-kv-value) {
    font-size: 14px;
    color: var(--text-secondary);
    font-weight: 500;
  }

  .page-content :global(.kv-badge-green) {
    color: var(--green);
  }

  .page-content :global(.kv-badge-amber) {
    color: var(--amber);
  }

  .page-content :global(.kv-badge-red) {
    color: var(--red);
  }

  /* Callout boxes */
  .page-content :global(.wiki-callout) {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 12px 16px;
    border-radius: 8px;
    margin: 16px 0;
    font-size: 14px;
    line-height: 1.5;
  }

  .page-content :global(.callout-icon) {
    flex-shrink: 0;
    margin-top: 1px;
  }

  .page-content :global(.callout-text) {
    flex: 1;
  }

  .page-content :global(.callout-info) {
    background: var(--blue-bg);
    border-left: 3px solid var(--blue);
    color: var(--blue);
  }

  .page-content :global(.callout-warning) {
    background: var(--amber-bg);
    border-left: 3px solid var(--amber);
    color: var(--amber);
  }

  .page-content :global(.callout-danger) {
    background: var(--red-bg);
    border-left: 3px solid var(--red);
    color: var(--red);
  }

  .page-content :global(.callout-success) {
    background: var(--green-bg);
    border-left: 3px solid var(--green);
    color: var(--green);
  }

  /* Code blocks */
  .page-content :global(.wiki-code-block) {
    display: block;
    background: var(--bg-input);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 14px 18px;
    margin: 16px 0;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .page-content :global(.wiki-inline-code) {
    background: var(--bg-input);
    padding: 2px 6px;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--accent);
  }

  .page-content :global(strong) {
    color: var(--text-primary);
    font-weight: 600;
  }

  .page-content :global(em) {
    color: var(--text-secondary);
    font-style: italic;
  }

  .page-raw-source {
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.6;
    color: var(--text-secondary);
    background: var(--bg-input);
